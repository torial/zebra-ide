# the names view() uses in g.toolIcon; registering before Gui.run is fine (queued)
def registerIdeIcons()
    Gui.registerIcon("ide.build", 12, 12, glyph(buildGlyph(), 0x50, 0x60, 0xB0))
    Gui.registerIcon("ide.run", 12, 12, glyph(runGlyph(), 0x2E, 0xA8, 0x4E))
    Gui.registerIcon("ide.tests", 12, 12, glyph(testsGlyph(), 0x2E, 0xA8, 0x4E))
    Gui.registerIcon("ide.coverage", 12, 12, glyph(coverageGlyph(), 0xC8, 0x90, 0x20))
    Gui.registerIcon("ide.debug", 12, 12, glyph(debugGlyph(), 0xB0, 0x40, 0x40))
    Gui.registerIcon("ide.continue", 12, 12, glyph(continueGlyph(), 0x2E, 0xA8, 0x4E))
    Gui.registerIcon("ide.next", 12, 12, glyph(nextGlyph(), 0x40, 0x70, 0xC0))
    Gui.registerIcon("ide.stepin", 12, 12, glyph(stepInGlyph(), 0x40, 0x70, 0xC0))
    Gui.registerIcon("ide.stepout", 12, 12, glyph(stepOutGlyph(), 0x40, 0x70, 0xC0))
    Gui.registerIcon("ide.stop", 12, 12, glyph(stopGlyph(), 0xC0, 0x40, 0x40))
