# icons.zbr -- the IDE's toolbar icons (2026-09-23), drawn as 12x12 glyphs: twelve rows of
# twelve characters, `#` a painted pixel and `.` a transparent one, so a glyph reads as what
# it is. `glyph` turns one into the straight-alpha RGBA bytes Gui.registerIcon takes; the
# runtime has no image decoder yet, and these are small enough that decoding one would be
# more code than drawing it. Pure: icons_test checks the byte arithmetic without a window.

def glyph(rows: List(str), r: int, g: int, b: int): str
    var sb = StringBuilder()
    var y: int = 0
    while y < 12
        var row: str = if(y < rows.len, rows.at(y), "")
        var x: int = 0
        while x < 12
            var lit: bool = x < row.len and row[x] == '#'
            sb.appendChar(if(lit, r, 0))
            sb.appendChar(if(lit, g, 0))
            sb.appendChar(if(lit, b, 0))
            sb.appendChar(if(lit, 255, 0))
            x = x + 1
        y = y + 1
    return sb.build()

# a hammer: head top-right, handle to the bottom-left
def buildGlyph(): List(str)
    var r: List(str) = List(str)()
    r.add("......####..")
    r.add(".....######.")
    r.add("....########")
    r.add("....######..")
    r.add("...###.###..")
    r.add("..###....#..")
    r.add(".###........")
    r.add("###.........")
    r.add("##..........")
    r.add("............")
    r.add("............")
    r.add("............")
    return r

