# textops_test — the IDE's pure text helpers, headless.   zebra src/textops_test.zbr
use textops exposing applyEdits, symbolLines, indentFor, isBlockOpener, lineStartOffsets

def main()
    # line offsets
    var offs: List(int) = lineStartOffsets("ab\ncd\n\nef")
    assert offs.len == 4 and offs.at(0) == 0 and offs.at(1) == 3 and offs.at(2) == 6 and offs.at(3) == 7

    # a WorkspaceEdit with three edits on one uri, given in FORWARD order, on two lines,
    # one of which changes length — must apply back to front so offsets stay valid
    var text: str = "def area(s: int): int\n    return area(s) + area(s)\n"
    var uri: str = "file:///t.zbr"
    var changes = Json.parse("{\"file:///t.zbr\":[" +
        "{\"range\":{\"start\":{\"line\":0,\"character\":4},\"end\":{\"line\":0,\"character\":8}},\"newText\":\"surface\"}," +
        "{\"range\":{\"start\":{\"line\":1,\"character\":11},\"end\":{\"line\":1,\"character\":15}},\"newText\":\"surface\"}," +
        "{\"range\":{\"start\":{\"line\":1,\"character\":21},\"end\":{\"line\":1,\"character\":25}},\"newText\":\"surface\"}]}")
    assert changes != nil
    var out: str = applyEdits(text, changes!, uri)
    assert out == "def surface(s: int): int\n    return surface(s) + surface(s)\n", "got: " + out
    # edits for another uri are ignored; an empty list is a no-op
    assert applyEdits(text, changes!, "file:///other.zbr") == text
    # a deletion (empty newText) and an insertion (empty range) together
    var ch2 = Json.parse("{\"u\":[{\"range\":{\"start\":{\"line\":0,\"character\":0},\"end\":{\"line\":0,\"character\":4}},\"newText\":\"\"},{\"range\":{\"start\":{\"line\":0,\"character\":4},\"end\":{\"line\":0,\"character\":4}},\"newText\":\"X\"}]}")
    assert applyEdits("abcdef", ch2!, "u") == "Xef", "got: " + applyEdits("abcdef", ch2!, "u")

    # symbolLines: DocumentSymbol shape and SymbolInformation shape
    var lines: List(int) = List(int)()
    var reply = Json.parse("{\"result\":[{\"name\":\"area\",\"range\":{\"start\":{\"line\":4,\"character\":0}}},{\"name\":\"main\",\"location\":{\"range\":{\"start\":{\"line\":9,\"character\":0}}}}]}")
    var outline: str = symbolLines(reply!, lines)
    assert outline == "5: area\n10: main\n", "got: " + outline
    assert lines.len == 2 and lines.at(0) == 4 and lines.at(1) == 9

    # auto-indent
    assert isBlockOpener("zebra", "def f(x: int): int") and isBlockOpener("zebra", "    if x > 1") and isBlockOpener("zebra", "else")
    assert not isBlockOpener("zebra", "    x = x + 1") and not isBlockOpener("zebra", "    return x")
    assert isBlockOpener("c", "int main(void) {") and not isBlockOpener("c", "    return 0;")
    assert isBlockOpener("zig", "pub fn main() !void {") and not isBlockOpener("zig", "    const x = 1;")
    var src: str = "def f()\n    var a = 1\n    if a\n        b()\n"
    assert indentFor("zebra", src, 1) == "    "            # after `def f()`
    assert indentFor("zebra", src, 2) == "    "            # after `    var a = 1`
    assert indentFor("zebra", src, 3) == "        "        # after `    if a`
    assert indentFor("zebra", src, 0) == ""
    assert indentFor("c", "int main(void) {\n", 1) == "    "
    assert indentFor("c", "\tx;\n", 1) == "\t"
    print("textops_test: ok")
