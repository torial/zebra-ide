# ide.zbr — zebra-ide, the program. Zebra + libui-ng + Scintilla + `zebra lsp`.
#
#   zebra --gui-backend=libui_ng src/ide.zbr        (deps beside the source)
#   zebra --gui-backend=tui       src/ide.zbr        (compile control; editors are stubs)
#
# What this file is: the IDE — many documents in one Scintilla control, live
# diagnostics from the language server drawn as squiggles and margin markers,
# go-to-definition, find-references, document symbols and rename (lsp.zbr),
# a project's build and gates (gates.zbr), a debugger over `zebra debug`
# (dap.zbr), find/replace — all through the raw Scintilla hatch (editor.sci /
# sciStr; ids in sci.zbr) plus the three event `take*` methods.
#
# Shape (MVU, see QUICKSTART §30): the Model is a CLASS (mutated in place; a
# struct would be copied into update and the edits lost), widgets are created on
# frame 0 and only their contents change afterwards (libui is retained-mode:
# the count and order of g.text/button/editor calls must be the same every
# frame). view() sends Msg.tick every frame; update(tick) is where the LSP is
# polled, dirty text is pushed, replies are applied. Nothing blocks.
#
# Panes are editors: the references list and the symbol outline are read-only
# CodeEditors (language "text"). "Jump" reads the pane's cursor line and goes
# there. This is deliberate: it needs no list widget, and lines are already
# the unit everything else speaks (Scintilla, LSP, the compiler's diagnostics).
#
# Known limits, stated rather than hidden:
#   * many documents in ONE Scintilla control via document pointers (plan P2):
#     each Buffer owns an SCI_CREATEDOCUMENT; switching is SCI_SETDOCPOINTER,
#     which keeps undo history per document; caret/scroll are saved by hand.
#     Tabs are one g.buttonId per open file, keyed by path (a closed tab's button is
#     hidden by the GUI section because the view stops emitting it — 09-08).
#   * no keyboard shortcuts: libui exposes no key events for Scintilla, and
#     Scintilla's own SCI_ASSIGNCMDKEY only maps keys to Scintilla commands;
#   * events arrive through the notify bridge (editor.takeModified /
#     takeCharAdded / takeMarginClick, fed by uiScintillaOnNotify in
#     zig-libui-ng's libui_scintilla/win.cxx); the text compare is kept as a
#     1-in-10-ticks fallback so the tui backend (no events) still works.

use lsp exposing LspClient, LspLocation, LspDiagnostic, jsonEscape
use buffers exposing Buffer, BufferSet, uriOf, pathOfUri, langOf, baseName
use gates exposing Manifest, GateSpec, GateRun, Diag, ToolSpec, loadManifest, joinPath, expandTool, toolUsesFile, dirOf
use tests exposing TestSuite, parseListOutput, applyRunOutput, applyListFailure, renderSuite, summaryOf, listSpec, runSpec, inheritVerdicts
use dap exposing DapClient, DapFrame, DapVar, DapScope
use textops exposing applyEdits, applyWorkspaceEditToDisk, symbolLines, indentFor, isBlockOpener, wordAt
use keys exposing shortcutAction, shortcutList, Shortcut, registerShortcuts
use sci exposing SCI_GOTOPOS, SCI_GOTOLINE, SCI_GETCURRENTPOS, SCI_LINEFROMPOSITION, SCI_GETCOLUMN, SCI_POSITIONFROMLINE, SCI_GETLENGTH, SCI_INDICSETSTYLE, SCI_INDICSETFORE, SCI_SETINDICATORCURRENT, SCI_INDICATORFILLRANGE, SCI_INDICATORCLEARRANGE, SCI_MARKERDEFINE, SCI_MARKERSETBACK, SCI_MARKERSETFORE, SCI_MARKERADD, SCI_MARKERDELETEALL, SCI_SETMARGINWIDTHN, SCI_SETMARGINTYPEN, SCI_SETMARGINMASKN, SCI_SETSAVEPOINT, SCI_GETMODIFY, SCI_ANNOTATIONSETTEXT, SCI_ANNOTATIONSETSTYLE, SCI_ANNOTATIONCLEARALL, SCI_ANNOTATIONSETVISIBLE, SCI_SCROLLCARET, SCI_STYLESETFORE, SCI_STYLESETBACK, SCI_STYLESETITALIC, INDIC_SQUIGGLE, SC_MARK_SHORTARROW, SC_MARK_CIRCLE, SC_MARK_BOOKMARK, SC_MARGIN_SYMBOL, ANNOTATION_BOXED, SCI_REPLACESEL, SCI_MARKERNEXT, SCI_MARKERGET, SCI_MARKERDELETE, SCI_SETMARGINSENSITIVEN, SCI_GETLINECOUNT, SCI_CREATEDOCUMENT, SCI_ADDREFDOCUMENT, SCI_RELEASEDOCUMENT, SCI_GETDOCPOINTER, SCI_SETDOCPOINTER, SCI_GETFIRSTVISIBLELINE, SCI_SETFIRSTVISIBLELINE, SCI_EMPTYUNDOBUFFER, SC_MARK_ARROW, SCI_SETTARGETSTART, SCI_SETTARGETEND, SCI_SEARCHINTARGET, SCI_REPLACETARGET, SCI_SETSEARCHFLAGS, SCI_SETSEL, SCI_GETSELECTIONSTART, SCI_GETSELECTIONEND, SCFIND_MATCHCASE

# ── Constants of this program ──────────────────────────────────────────────
const INDIC_ERROR: int = 8          # indicator slots 8..31 are free for containers
const INDIC_WARN: int = 9
const MARKER_ERROR: int = 1         # marker numbers; 0 is left to the debugger phase
const MARKER_WARN: int = 2
const MARGIN_MARKS: int = 1         # margin 0 = line numbers (set by the editor); 1 = ours
const DIRTY_TICKS: int = 3          # ticks (~100 ms each) of quiet before didChange
const STYLE_ANNOT: int = 40         # style slot for inline diagnostic annotations
const MARKER_BOOKMARK: int = 3      # "Toggle bookmark" button
const MARKER_BREAK: int = 0         # toggled by clicking the marker margin; sent to the debugger
const MARKER_CURRENT: int = 4       # the debugger's current line

class Model
    var editor: CodeEditor? = nil
    var refs: CodeEditor? = nil          # references pane (read-only)
    var outline: CodeEditor? = nil       # symbols pane (read-only)
    var servers: HashMap(str, LspClient)   # one language server per language: zebra / c / zig
    var servers_tried: List(str)           # languages whose server start already failed (say so once)
    var req_lang: str = ""                 # the language whose server holds the pending def/refs/sym/rename ids
    var tool_reload: HashMap(str, str)     # run tag → file to re-read after exit 0
    var tool_nodiags: HashMap(str, bool)   # run tags whose output must NOT be marked as diagnostics
    var summary_pending: bool = false      # print "N/N passed" when the queue drains (gates/build only)
    var bufs: BufferSet
    var status: str = "no file"
    var pending_text: str = ""           # text seen last tick (for quiet detection)
    var quiet: int = 0
    var base_doc: int = 0                # the control's original document (kept alive, unused)
    var def_id: int = 0
    var refs_id: int = 0
    var sym_id: int = 0
    var rename_id: int = 0
    var ref_lines: List(int)             # pane line -> source line (0-based)
    var ref_uris: List(str)
    var sym_lines: List(int)
    var new_name: str = ""
    var find_text: str = ""
    var replace_text: str = ""
    var errors: int = 0
    var warnings: int = 0
    var overlay_ready: bool = false      # Scintilla exists only after the first render
    var tick_n: int = 0
    var close_armed: int = -1            # buffer index whose unsaved close was refused once
    # project gates (gates.zbr): manifest, the run in flight, the queue behind it,
    # and the output pane's line → diagnostic map for "Jump to diagnostic"
    var manifest: Manifest? = nil
    var manifest_path: str = ""
    var run: GateRun? = nil
    var queue: List(GateSpec)
    var gate_pane: CodeEditor? = nil
    var pane_lines: List(str)
    var pane_diag: List(Diag)
    var pane_diag_idx: List(int)         # per pane line: index into pane_diag or -1
    var gates_failed: int = 0
    var gates_done: int = 0
    var gates_skipped: int = 0
    # tests (tests.zbr): the suite for one file, its pane, and the pane's line → source
    # line map ("Jump to test"); a run is two queued GateRuns (--list, then test)
    var tests: TestSuite? = nil
    var tests_pane: CodeEditor? = nil
    var tests_lines: List(str)
    var tests_jumps: List(int)
    var tests_only: List(str)            # the subset the queued run covers ("" = all)
    # debugger (dap.zbr): the session, the frames pane, and what we asked for
    var dbg: DapClient? = nil
    var dbg_pane: CodeEditor? = nil
    var dbg_frames_id: int = 0
    var dbg_scopes_id: int = 0                 # scopes request for the top frame
    var dbg_var_req: HashMap(int, str)         # variables request id → scope name
    var dbg_vars_text: str = ""                # rendered scopes, appended under the frames
    var dbg_launched: bool = false
    var dbg_src: str = ""
    var dbg_last_state: str = ""
    var dbg_output_len: int = 0

    cue init()
        .ref_lines = List(int)()
        .ref_uris = List(str)()
        .sym_lines = List(int)()
        .bufs = BufferSet()
        .servers = HashMap(str, LspClient)()
        .servers_tried = List(str)()
        .queue = List(GateSpec)()
        .pane_lines = List(str)()
        .pane_diag = List(Diag)()
        .pane_diag_idx = List(int)()
        .dbg_var_req = HashMap(int, str)()
        .tool_reload = HashMap(str, str)()
        .tool_nodiags = HashMap(str, bool)()
        .tests_lines = List(str)()
        .tests_jumps = List(int)()
        .tests_only = List(str)()

union Msg
    tick
    open_file
    save_file
    goto_def
    find_refs
    symbols
    rename
    jump_ref
    jump_sym
    next_bookmark
    select_tab: int
    close_tab
    build
    run_gates
    reload_manifest
    jump_diag
    toggle_bookmark
    toggle_breakpoint
    debug_start
    debug_continue
    debug_next
    debug_step_in
    debug_step_out
    debug_stop
    jump_frame
    find_next
    run_tool: int
    replace_one
    replace_all
    run_file            # `zebra <current file>`, output in the gates pane (Ctrl+R)
    run_tests           # `zebra test` on the current file, structured in the tests pane
    rerun_failed_tests  # `zebra test --only <the failed ones>`
    jump_test

# ── Helpers ────────────────────────────────────────────────────────────────
def cursorLine(ed: CodeEditor): int
    var pos: int = ed.sci(SCI_GETCURRENTPOS, 0, 0)
    return ed.sci(SCI_LINEFROMPOSITION, pos, 0)

def cursorCol(ed: CodeEditor): int
    var pos: int = ed.sci(SCI_GETCURRENTPOS, 0, 0)
    return ed.sci(SCI_GETCOLUMN, pos, 0)

def gotoLineCol(ed: CodeEditor, line: int, col: int)
    var pos: int = ed.sci(SCI_POSITIONFROMLINE, line, 0) + col
    ed.sci(SCI_GOTOPOS, pos, 0)
    ed.sci(SCI_SCROLLCARET, 0, 0)

# One-time Scintilla setup for the diagnostics overlay. Colours are 0xBBGGRR.
def configureOverlay(ed: CodeEditor)
    ed.sci(SCI_INDICSETSTYLE, INDIC_ERROR, INDIC_SQUIGGLE)
    ed.sci(SCI_INDICSETFORE, INDIC_ERROR, 0x5c5ce0)      # #e05c5c
    ed.sci(SCI_INDICSETSTYLE, INDIC_WARN, INDIC_SQUIGGLE)
    ed.sci(SCI_INDICSETFORE, INDIC_WARN, 0x4fb8e0)       # #e0b84f
    ed.sci(SCI_MARKERDEFINE, MARKER_ERROR, SC_MARK_SHORTARROW)
    ed.sci(SCI_MARKERSETBACK, MARKER_ERROR, 0x5c5ce0)
    ed.sci(SCI_MARKERSETFORE, MARKER_ERROR, 0x5c5ce0)
    ed.sci(SCI_MARKERDEFINE, MARKER_WARN, SC_MARK_CIRCLE)
    ed.sci(SCI_MARKERSETBACK, MARKER_WARN, 0x4fb8e0)
    ed.sci(SCI_MARKERSETFORE, MARKER_WARN, 0x4fb8e0)
    ed.sci(SCI_SETMARGINTYPEN, MARGIN_MARKS, SC_MARGIN_SYMBOL)
    ed.sci(SCI_SETMARGINWIDTHN, MARGIN_MARKS, 16)
    ed.sci(SCI_SETMARGINMASKN, MARGIN_MARKS, 31)           # bits for markers 0..4
    ed.sci(SCI_SETMARGINSENSITIVEN, MARGIN_MARKS, 1)       # clicks arrive as SCN_MARGINCLICK
    ed.sci(SCI_MARKERDEFINE, MARKER_BOOKMARK, SC_MARK_BOOKMARK)
    ed.sci(SCI_MARKERSETBACK, MARKER_BOOKMARK, 0xc2b656)
    ed.sci(SCI_MARKERDEFINE, MARKER_BREAK, SC_MARK_CIRCLE)
    ed.sci(SCI_MARKERSETBACK, MARKER_BREAK, 0x3030d0)      # red dot
    ed.sci(SCI_MARKERSETFORE, MARKER_BREAK, 0x3030d0)
    ed.sci(SCI_MARKERDEFINE, MARKER_CURRENT, SC_MARK_ARROW)
    ed.sci(SCI_MARKERSETBACK, MARKER_CURRENT, 0x40d0f0)    # yellow arrow
    ed.sci(SCI_MARKERSETFORE, MARKER_CURRENT, 0x40d0f0)
    ed.sci(SCI_ANNOTATIONSETVISIBLE, ANNOTATION_BOXED, 0)
    ed.sci(SCI_STYLESETFORE, STYLE_ANNOT, 0x9a9ad0)        # #d09a9a
    ed.sci(SCI_STYLESETBACK, STYLE_ANNOT, 0x2f2823)
    ed.sci(SCI_STYLESETITALIC, STYLE_ANNOT, 1)

# Draw the server's diagnostics for the current document: squiggles under each
# range, a marker in the margin, the message as a boxed annotation under the line.
def applyDiagnostics(m: Model, ds: List(LspDiagnostic))
    var ed: CodeEditor = m.editor!
    var n: int = ed.sci(SCI_GETLENGTH, 0, 0)
    ed.sci(SCI_SETINDICATORCURRENT, INDIC_ERROR, 0)
    ed.sci(SCI_INDICATORCLEARRANGE, 0, n)
    ed.sci(SCI_SETINDICATORCURRENT, INDIC_WARN, 0)
    ed.sci(SCI_INDICATORCLEARRANGE, 0, n)
    ed.sci(SCI_MARKERDELETEALL, MARKER_ERROR, 0)
    ed.sci(SCI_MARKERDELETEALL, MARKER_WARN, 0)
    ed.sci(SCI_ANNOTATIONCLEARALL, 0, 0)
    m.errors = 0
    m.warnings = 0
    for d in ds
        var is_err: bool = d.severity <= 1
        var start: int = ed.sci(SCI_POSITIONFROMLINE, d.line, 0) + d.col
        var stop: int = ed.sci(SCI_POSITIONFROMLINE, d.end_line, 0) + d.end_col
        if stop <= start
            stop = start + 1
        if is_err
            ed.sci(SCI_SETINDICATORCURRENT, INDIC_ERROR, 0)
            ed.sci(SCI_MARKERADD, d.line, MARKER_ERROR)
            m.errors = m.errors + 1
        else
            ed.sci(SCI_SETINDICATORCURRENT, INDIC_WARN, 0)
            ed.sci(SCI_MARKERADD, d.line, MARKER_WARN)
            m.warnings = m.warnings + 1
        ed.sci(SCI_INDICATORFILLRANGE, start, stop - start)
        ed.sciStr(SCI_ANNOTATIONSETTEXT, d.line, d.message)
        ed.sci(SCI_ANNOTATIONSETSTYLE, d.line, STYLE_ANNOT)

# Apply a WorkspaceEdit's edits for our uri to `text` (edits are applied from
# the end of the document backwards so earlier offsets stay valid).
# ── Model lifecycle ────────────────────────────────────────────────────────
# The compiler that serves LSP and debug: ZEBRA_COMPILER when the IDE was started
# by `zebra src/ide.zbr` (the compiler sets it for programs it runs), otherwise
# `zebra` on PATH (the IDE run as its own exe).
def compilerPath(): str
    var zopt = sys.getenv("ZEBRA_COMPILER")
    if zopt as z
        if z != ""
            return z
    return "zebra"

# The command that serves a language. `zebra lsp` from the compiler; clangd and zls
# from PATH (C and Zig). Started lazily, the first time a buffer of that language
# opens; a server that cannot start is reported once in the status line and the
# language keeps colouring only.
def serverArgv(lang: str): List(str)
    var argv: List(str) = List(str)()
    if lang == "zebra"
        argv.add(compilerPath())
        argv.add("lsp")
    else if lang == "c"
        argv.add("clangd")
        argv.add("--log=error")
    else if lang == "zig"
        argv.add("zls")
    return argv

def serverLabel(lang: str): str
    if lang == "zebra"
        return "zebra lsp"
    if lang == "c"
        return "clangd"
    if lang == "zig"
        return "zls"
    return ""

def startServer(m: Model, lang: str): LspClient?
    if m.servers.get(lang) as have
        return have
    if m.servers_tried.contains(lang)
        return nil
    m.servers_tried.add(lang)
    var argv: List(str) = serverArgv(lang)
    if argv.len == 0
        return nil
    var c = LspClient()
    if not c.start(lang, argv)
        if lang == "zebra"
            m.status = "could not start `" + compilerPath() + " lsp` (set ZEBRA_COMPILER or put zebra on PATH)"
        else
            m.status = serverLabel(lang) + " not on PATH — " + lang + " gets colouring only"
        return nil
    m.servers.put(lang, c)
    c.initialize(uriOf(sys.cwd()))
    return c

# The server for a language, if it is running (started or not).
def lspFor(m: Model, lang: str): LspClient?
    if m.servers.get(lang) as c
        return c
    return nil

# The server for the current buffer's language.
def lspCur(m: Model): LspClient?
    if m.bufs.cur() as b
        return lspFor(m, b.lang)
    return nil

def startLsp(m: Model)
    startServer(m, "zebra")

# ── Documents: one control, many Scintilla documents ─────────────────────────
# Save the view state Scintilla does not keep per document.
def saveView(m: Model)
    if m.bufs.cur() as b
        b.caret = m.editor!.sci(SCI_GETCURRENTPOS, 0, 0)
        b.first_line = m.editor!.sci(SCI_GETFIRSTVISIBLELINE, 0, 0)
        if b.docptr == 0
            b.text = m.editor!.getText()        # tui: the text lives in the Buffer

# Make buffer i current in the control. Works with docptr (libui) or text (tui).
def showBuffer(m: Model, i: int)
    var ed: CodeEditor = m.editor!
    var b: Buffer = m.bufs.items.at(i)
    m.bufs.current = i
    ed.setLanguage(b.lang)
    if b.docptr != 0
        ed.sci(SCI_SETDOCPOINTER, 0, b.docptr)
        ed.restyle()
    else
        ed.setText(b.text)
    ed.sci(SCI_GOTOPOS, b.caret, 0)
    ed.sci(SCI_SETFIRSTVISIBLELINE, b.first_line, 0)
    m.pending_text = ed.getText()
    m.quiet = 0
    m.errors = b.errors
    m.warnings = b.warnings
    if lspFor(m, b.lang) as c
        if c.initialized and c.diagnostics.get(b.uri) == nil and b.opened_lsp
            c.diagnostics.put(b.uri, List(LspDiagnostic)())   # nothing pending: overlay stays as drawn
    # diagnostics for this document, if any arrived while it was hidden
    if lspFor(m, b.lang) as c2
        if c2.diagnostics.get(b.uri) as ds
            applyDiagnostics(m, ds)
            c2.diagnostics.remove(b.uri)

def switchTo(m: Model, i: int)
    if i < 0 or i >= m.bufs.count() or i == m.bufs.current
        return
    saveView(m)
    showBuffer(m, i)

# Returns true when `p` is now the current buffer; callers must not move the
# caret when it is not (advocate finding 8, 2026-09-07).
def openFile(m: Model, p: str): bool
    var existing: int = m.bufs.find(p)
    if existing >= 0
        switchTo(m, existing)
        m.status = "switched"
        return true
    if not File.exists(p)
        m.status = "not found: " + p
        return false
    var text: str = File.read(p)
    saveView(m)
    var i: int = m.bufs.open(p, text)
    var b: Buffer = m.bufs.items.at(i)
    var ed: CodeEditor = m.editor!
    # A fresh Scintilla document (refcount 1, ours). On tui the hatch returns 0 and
    # the Buffer's text is the document.
    b.docptr = ed.sci(SCI_CREATEDOCUMENT, 0, 0)
    if b.docptr != 0
        ed.sci(SCI_SETDOCPOINTER, 0, b.docptr)
    ed.setLanguage(b.lang)
    ed.setText(text)
    ed.sci(SCI_EMPTYUNDOBUFFER, 0, 0)
    ed.sci(SCI_SETSAVEPOINT, 0, 0)
    m.bufs.current = i
    m.pending_text = text
    m.quiet = 0
    m.errors = 0
    m.warnings = 0
    # Each buffer goes to ITS language's server (zebra lsp / clangd / zls), never to
    # another's: `zebra lsp` would report a valid C file as a Zebra parse error, a
    # fabricated diagnostic (advocate finding 3, 09-07). A server that is not
    # running yet is started here; the tick's late-initialize opens the buffer once
    # the server answers initialize.
    m.status = "opened " + baseName(p)
    if startServer(m, b.lang) as c
        if c.initialized
            c.didOpen(b.uri, b.lang, 1, text)
            b.opened_lsp = true
    else if serverLabel(b.lang) != ""
        m.status = "opened " + baseName(p) + " (" + b.lang + ": colouring only — " + serverLabel(b.lang) + " not running)"
    else
        m.status = "opened " + baseName(p) + " (" + b.lang + ": colouring only)"
    runHooks(m, "open")
    return true

def closeCurrent(m: Model)
    var i: int = m.bufs.current
    if i < 0
        return
    var b: Buffer = m.bufs.items.at(i)
    if lspFor(m, b.lang) as c
        if b.opened_lsp
            c.didClose(b.uri)
    var doc: int = b.docptr
    m.bufs.close(i)
    if m.bufs.count() > 0
        showBuffer(m, m.bufs.current)
    else
        m.editor!.sci(SCI_SETDOCPOINTER, 0, m.base_doc)
        m.editor!.setText("")
        m.pending_text = ""
    if doc != 0
        m.editor!.sci(SCI_RELEASEDOCUMENT, 0, doc)
    m.status = "closed " + baseName(b.path)

# Keyboard shortcuts: the table and registerShortcuts live in keys.zbr; this maps an
# action name to the Msg. Unclaimed chords stay Scintilla's.
def shortcutMsg(k: int, debugging: bool): Msg?
    var a: str = shortcutAction(k, debugging)
    if a == "save"
        return Msg.save_file
    if a == "close"
        return Msg.close_tab
    if a == "find"
        return Msg.find_next
    if a == "build"
        return Msg.build
    if a == "gates"
        return Msg.run_gates
    if a == "run"
        return Msg.run_file
    if a == "tests"
        return Msg.run_tests
    if a == "rerun_failed"
        return Msg.rerun_failed_tests
    if a == "debug"
        return Msg.debug_start
    if a == "continue"
        return Msg.debug_continue
    if a == "stop"
        return Msg.debug_stop
    if a == "breakpoint"
        return Msg.toggle_breakpoint
    if a == "next"
        return Msg.debug_next
    if a == "step_in"
        return Msg.debug_step_in
    if a == "step_out"
        return Msg.debug_step_out
    if a == "definition"
        return Msg.goto_def
    if a == "references"
        return Msg.find_refs
    return nil

def ideInit(): Model
    var m = Model()
    m.editor = CodeEditor.forZebra()
    registerShortcuts(m.editor!)
    m.refs = CodeEditor.forFile("references.txt")
    m.refs!.setReadOnly(true)
    m.refs!.setText("(references appear here)")
    m.outline = CodeEditor.forFile("symbols.txt")
    m.outline!.setReadOnly(true)
    m.outline!.setText("(symbols appear here)")
    m.gate_pane = CodeEditor.forFile("gates.txt")
    m.gate_pane!.setReadOnly(true)
    m.gate_pane!.setText("(build and gate output appears here)")
    m.dbg_pane = CodeEditor.forFile("debug.txt")
    m.dbg_pane!.setReadOnly(true)
    m.dbg_pane!.setText("(debugger: click the margin for a breakpoint, then Debug)")
    m.tests_pane = CodeEditor.forFile("tests.txt")
    m.tests_pane!.setReadOnly(true)
    m.tests_pane!.setText("(Run tests: every def test_*() in the current file, via `zebra test`)")
    loadProject(m)
    startLsp(m)
    for p in startup_files
        openFile(m, p)
    return m

# Files named on the command line, read ONLY in main(): a `use`d module's `sys.args()`
# reads an uninitialised preamble global in a GUI build (BUG-357), and model_test
# imports this module.
var startup_files: List(str) = List(str)()

# On Enter: copy the previous line's indentation, plus one level after a block opener.
# Runs from the notify bridge (SCN_CHARADDED '\n'), so it costs nothing while idle.
def autoIndent(m: Model)
    var ed: CodeEditor = m.editor!
    var indent: str = indentFor(ed.getLanguage(), ed.getText(), cursorLine(ed))
    if indent != ""
        ed.sciStr(SCI_REPLACESEL, 0, indent)

def markerBit(marker: int): int
    var b: int = 1
    var k: int = 0
    while k < marker
        b = b * 2
        k = k + 1
    return b

def toggleMarker(ed: CodeEditor, line: int, marker: int)
    var mask: int = ed.sci(SCI_MARKERGET, line, 0)
    if (mask / markerBit(marker)) % 2 == 1
        ed.sci(SCI_MARKERDELETE, line, marker)
    else
        ed.sci(SCI_MARKERADD, line, marker)

# 1-based lines carrying `marker` in the current document (SCI_MARKERNEXT walks them).
def markerLines(ed: CodeEditor, marker: int): List(int)
    var out: List(int) = List(int)()
    var from: int = 0
    while true
        var l: int = ed.sci(SCI_MARKERNEXT, from, markerBit(marker))
        if l < 0
            break
        out.add(l + 1)
        from = l + 1
    return out

# Apply a rename's WorkspaceEdit everywhere it points: open buffers are edited in
# their Scintilla documents (switching document pointers under the hood, view
# state restored); files that are not open are rewritten on disk and said so.
def applyWorkspaceEdit(m: Model, changes: JsonValue): str
    var start_idx: int = m.bufs.current
    var line: int = cursorLine(m.editor!)
    var col: int = cursorCol(m.editor!)
    var n_open: int = 0
    var open_uris: List(str) = List(str)()
    for u in changes.keys()
        var bi: int = m.bufs.findUri(u)
        if bi >= 0
            switchTo(m, bi)
            var edited: str = applyEdits(m.editor!.getText(), changes, u)
            m.editor!.setText(edited)
            n_open = n_open + 1
            open_uris.add(u)
    var n_disk: int = applyWorkspaceEditToDisk(changes, open_uris)
    if start_idx >= 0
        switchTo(m, start_idx)
        gotoLineCol(m.editor!, line, col)
    return "renamed in " + n_open.toString() + " open buffer(s) (unsaved — Save each) and " + n_disk.toString() + " unopened file(s) written to disk"

# ── Find / replace (Scintilla's target search; case-sensitive, plain text) ──────
# Search from `from`; on a hit select it and return its start, else -1 (wraps once).
def findFrom(ed: CodeEditor, needle: str, from: int): int
    if needle == ""
        return -1
    var n: int = ed.sci(SCI_GETLENGTH, 0, 0)
    ed.sci(SCI_SETSEARCHFLAGS, SCFIND_MATCHCASE, 0)
    ed.sci(SCI_SETTARGETSTART, from, 0)
    ed.sci(SCI_SETTARGETEND, n, 0)
    var pos: int = ed.sciStr(SCI_SEARCHINTARGET, needle.len, needle)
    if pos < 0 and from > 0
        ed.sci(SCI_SETTARGETSTART, 0, 0)
        ed.sci(SCI_SETTARGETEND, n, 0)
        pos = ed.sciStr(SCI_SEARCHINTARGET, needle.len, needle)
    if pos >= 0
        ed.sci(SCI_SETSEL, pos, pos + needle.len)
        ed.sci(SCI_SCROLLCARET, 0, 0)
    return pos

def findNext(m: Model)
    var ed: CodeEditor = m.editor!
    var from: int = ed.sci(SCI_GETSELECTIONEND, 0, 0)
    var pos: int = findFrom(ed, m.find_text, from)
    if pos < 0
        m.status = "not found: " + m.find_text
    else
        m.status = "found at line " + (ed.sci(SCI_LINEFROMPOSITION, pos, 0) + 1).toString()

# Replace the current selection if it is a hit, then find the next one.
def replaceOne(m: Model)
    var ed: CodeEditor = m.editor!
    var s0: int = ed.sci(SCI_GETSELECTIONSTART, 0, 0)
    var s1: int = ed.sci(SCI_GETSELECTIONEND, 0, 0)
    if s1 - s0 == m.find_text.len and m.find_text != ""
        ed.sci(SCI_SETTARGETSTART, s0, 0)
        ed.sci(SCI_SETTARGETEND, s1, 0)
        ed.sciStr(SCI_REPLACETARGET, m.replace_text.len, m.replace_text)
        ed.sci(SCI_SETSEL, s0 + m.replace_text.len, s0 + m.replace_text.len)
    findNext(m)

def replaceAll(m: Model)
    var ed: CodeEditor = m.editor!
    if m.find_text == ""
        return
    var count: int = 0
    var from: int = 0
    while true
        var n: int = ed.sci(SCI_GETLENGTH, 0, 0)
        ed.sci(SCI_SETSEARCHFLAGS, SCFIND_MATCHCASE, 0)
        ed.sci(SCI_SETTARGETSTART, from, 0)
        ed.sci(SCI_SETTARGETEND, n, 0)
        var pos: int = ed.sciStr(SCI_SEARCHINTARGET, m.find_text.len, m.find_text)
        if pos < 0
            break
        ed.sciStr(SCI_REPLACETARGET, m.replace_text.len, m.replace_text)
        from = pos + m.replace_text.len
        count = count + 1
        if count > 100000
            break
    m.status = "replaced " + count.toString() + " occurrence(s)"

# ── Project gates ────────────────────────────────────────────────────────────
def findManifest(): str
    var p: str = "zebra-ide.json"
    if File.exists(p)
        return p
    return ""

def loadProject(m: Model)
    var p: str = findManifest()
    if p == ""
        m.manifest = nil
        m.manifest_path = ""
        m.status = "no zebra-ide.json in " + sys.cwd()
        return
    m.manifest = loadManifest(p)
    m.manifest_path = p
    if m.manifest as mf
        m.status = "project " + mf.name + ": " + mf.gates.len.toString() + " gate(s)"
    else
        m.status = "zebra-ide.json did not parse"

def paneAppend(m: Model, line: str, d: Diag?)
    m.pane_lines.add(line)
    if d as dd
        m.pane_diag.add(dd)
        m.pane_diag_idx.add(m.pane_diag.len - 1)
    else
        m.pane_diag_idx.add(-1)

def paneRefresh(m: Model)
    var sb = StringBuilder()
    for l in m.pane_lines
        sb.append(l + "\n")
    m.gate_pane!.setReadOnly(false)
    m.gate_pane!.setText(sb.build())
    m.gate_pane!.setReadOnly(true)
    var last: int = m.pane_lines.len
    m.gate_pane!.sci(SCI_GOTOLINE, last, 0)

def paneClear(m: Model)
    m.pane_lines = List(str)()
    m.pane_diag = List(Diag)()
    m.pane_diag_idx = List(int)()

def startNextGate(m: Model)
    if m.queue.len == 0
        return
    var spec: GateSpec = m.queue.at(0)
    m.queue.remove(0)
    var r = GateRun(spec)
    paneAppend(m, "▶ " + spec.name + ": " + spec.argv.join(" ") + "   (in " + spec.cwd + ")", nil)
    if not r.start()
        paneAppend(m, "   could not start", nil)
        m.gates_failed = m.gates_failed + 1
        m.gates_done = m.gates_done + 1
        paneRefresh(m)
        startNextGate(m)
        return
    m.run = r
    paneRefresh(m)

# Build diagnostics for the CURRENT buffer drawn like the LSP's (1-based → 0-based).
def markBuildDiags(m: Model, diags: List(Diag))
    if m.bufs.cur() as b
        var ds: List(LspDiagnostic) = List(LspDiagnostic)()
        var root: str = "."
        if m.manifest as mf
            root = mf.root
        var bpath: str = b.path.replace("\\", "/")
        for d in diags
            var full: str = joinPath(root, d.path).replace("\\", "/")   # BUG-346 fixed 09-08
            if bpath == full or full.endsWith(bpath) or bpath.endsWith(full)
                var sev: int = 1
                if d.severity == "warning"
                    sev = 2
                if d.severity == "note"
                    sev = 3
                var col: int = 0
                if d.col > 0
                    col = d.col - 1
                ds.add(LspDiagnostic(b.uri, d.line - 1, col, d.line - 1, col + 1, sev, d.message))
        if ds.len > 0
            applyDiagnostics(m, ds)
            b.errors = m.errors
            b.warnings = m.warnings

def pollGates(m: Model)
    if m.run as r
        if r.poll()
            m.run = nil
            m.gates_done = m.gates_done + 1
            if r.skipped
                m.gates_skipped = m.gates_skipped + 1
            else if not r.ok
                m.gates_failed = m.gates_failed + 1
            # the tool's own output, then its parsed diagnostics as jumpable lines
            for l in r.output.split("\n")
                if l.trim() != ""
                    paneAppend(m, "   " + l, nil)
            for d in r.diags
                paneAppend(m, "   ↳ " + d.path + ":" + d.line.toString() + ": " + d.severity + ": " + d.message, d)
            paneAppend(m, r.verdict() + "  " + r.spec.name + "  (" + r.elapsed_ms.toString() + " ms, exit " + r.exit_code.toString() + ")", nil)
            if m.tool_nodiags.get(r.spec.tag) == nil
                markBuildDiags(m, r.diags)
            else
                m.tool_nodiags.remove(r.spec.tag)
            if r.spec.tag == "tests:list"
                testsListDone(m, r)
            else if r.spec.tag == "tests:run"
                testsRunDone(m, r)
            if m.tool_reload.get(r.spec.tag) as rp
                m.tool_reload.remove(r.spec.tag)
                if r.exit_code == 0
                    reloadBuffer(m, rp)
            if m.queue.len == 0 and m.summary_pending
                m.summary_pending = false
                var ran: int = m.gates_done - m.gates_skipped
                var summary: str = (ran - m.gates_failed).toString() + "/" + ran.toString() + " passed"
                if m.gates_skipped > 0
                    summary = summary + ", " + m.gates_skipped.toString() + " skipped (could not run here)"
                paneAppend(m, "── " + summary, nil)
                m.status = summary
            paneRefresh(m)
            startNextGate(m)
        else
            # live tail while it runs: keep the pane's last line as a heartbeat
            m.status = "running " + r.spec.name + " … " + (r.elapsed_ms / 1000).toString() + " s"

# ── Tests (tests.zbr) ──────────────────────────────────────────────────────────
# Two queued runs: `zebra test --list FILE` (front end only, ~60 ms) builds the suite
# from the compiler's own discovery rule, then `zebra test [--only …] FILE` runs it;
# both go through the gates queue, so they never overlap a build and their raw output
# lands in the gates pane like any tool's. The tests pane holds the structured view.
def testsRefresh(m: Model)
    m.tests_lines = List(str)()
    m.tests_jumps = List(int)()
    if m.tests as t
        renderSuite(t, m.tests_lines, m.tests_jumps)
        m.status = "tests: " + summaryOf(t)
    var sb = StringBuilder()
    for l in m.tests_lines
        sb.append(l + "\n")
    m.tests_pane!.setReadOnly(false)
    m.tests_pane!.setText(sb.build())
    m.tests_pane!.setReadOnly(true)

# Save first when dirty (the compiler reads the disk), then queue the --list.
def startTests(m: Model, only: List(str))
    if m.run != nil
        m.status = "a gate is still running"
        return
    if m.bufs.cur() as b
        if not b.path.endsWith(".zbr")
            m.status = "tests: " + baseName(b.path) + " is not a Zebra file"
            return
        var text: str = m.editor!.getText()
        var dirty: bool = m.editor!.sci(SCI_GETMODIFY, 0, 0) != 0
        if not dirty and File.exists(b.path)
            dirty = text != File.read(b.path)
        if dirty
            File.write(b.path, text)
            m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
        var keep: bool = false
        if m.tests as prev
            keep = only.len > 0 and prev.file == b.path
        if not keep
            m.tests = TestSuite(b.path)
        m.tests_only = only
        var spec: GateSpec = listSpec(compilerPath(), baseName(b.path), dirOf(b.path))
        m.tool_nodiags.put(spec.tag, true)       # a --list refusal is reported in the tests pane, not as markers
        paneClear(m)
        m.queue.add(spec)
        startNextGate(m)
        testsRefresh(m)
    else
        m.status = "tests: no file open"

def testsListDone(m: Model, r: GateRun)
    if m.tests as t
        if r.exit_code == 0
            var fresh: TestSuite = parseListOutput(t.file, r.output)
            if m.tests_only.len > 0
                inheritVerdicts(fresh, t)
            m.tests = fresh
            if fresh.cases.len > 0
                m.queue.add(runSpec(compilerPath(), baseName(t.file), dirOf(t.file), m.tests_only))
        else
            applyListFailure(t, r.output)
        testsRefresh(m)

def testsRunDone(m: Model, r: GateRun)
    if m.tests as t
        applyRunOutput(t, r.output, m.tests_only)
        testsRefresh(m)

# `zebra FILE` on the current buffer: save when dirty, run in the file's directory,
# output (and any compile diagnostics, marked) in the gates pane.
def runCurrentFile(m: Model)
    if m.run != nil
        m.status = "a gate is still running"
        return
    if m.bufs.cur() as b
        var text: str = m.editor!.getText()
        var dirty: bool = m.editor!.sci(SCI_GETMODIFY, 0, 0) != 0
        if not dirty and File.exists(b.path)
            dirty = text != File.read(b.path)
        if dirty
            File.write(b.path, text)
            m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
        var argv: List(str) = List(str)()
        argv.add(compilerPath())
        argv.add(baseName(b.path))
        paneClear(m)
        m.queue.add(GateSpec(name: "run " + baseName(b.path), argv: argv, cwd: dirOf(b.path), expect: "", skip: "", timeout_ms: 600000, tag: "run:file"))
        startNextGate(m)
    else
        m.status = "run: no file open"

# For headless tests (model_test): a CodeEditor cannot cross a module boundary
# (BUG-355), but its text can.
def editorText(m: Model): str
    return m.editor!.getText()

def editorOf(m: Model): CodeEditor
    return m.editor!

def setEditorText(m: Model, text: str)
    m.editor!.setText(text)
    m.pending_text = text

# ── Tools (process plugins; wiki concept_zebra-ide-plugins) ───────────────────
# Re-read a file from disk into its buffer (a formatter rewrote it). The current
# buffer keeps its caret line; a hidden buffer's text is replaced in place.
def reloadBuffer(m: Model, path: str)
    var i: int = m.bufs.find(path)
    if i < 0
        return
    if not File.exists(path)
        return
    var text: str = File.read(path)
    if i == m.bufs.current
        var line: int = cursorLine(m.editor!)
        m.editor!.setText(text)
        m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
        gotoLineCol(m.editor!, line, 0)
        m.pending_text = text
        m.bufs.items.at(i).last_sent = ""       # the server gets the new text on the next tick
        m.status = "reloaded " + baseName(path)
    else
        var hb: Buffer = m.bufs.items.at(i)
        if hb.docptr != 0
            var keep: int = m.editor!.sci(SCI_GETDOCPOINTER, 0, 0)
            m.editor!.sci(SCI_SETDOCPOINTER, 0, hb.docptr)
            m.editor!.setText(text)
            m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
            m.editor!.sci(SCI_SETDOCPOINTER, 0, keep)
        else
            hb.text = text
        hb.last_sent = ""

# Run one tool on the current buffer: save first when the tool names ${file} and the
# buffer is dirty (a formatter on unsaved text would be a lie), substitute, enqueue.
def runTool(m: Model, t: ToolSpec)
    if m.bufs.cur() as b
        var text: str = m.editor!.getText()
        # dirty = Scintilla says so, OR the text differs from the file (the tui backend's
        # stub answers 0 to every sci message; the comparison is what model_test relies on)
        var dirty: bool = m.editor!.sci(SCI_GETMODIFY, 0, 0) != 0
        if not dirty and File.exists(b.path)
            dirty = text != File.read(b.path)
        if toolUsesFile(t) and dirty
            File.write(b.path, text)
            m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
        var line: int = cursorLine(m.editor!)
        var col: int = cursorCol(m.editor!)
        var spec: GateSpec = expandTool(t, b.path, line + 1, col + 1, wordAt(text, line, col))
        if t.reload
            m.tool_reload.put(spec.tag, b.path)
        if not t.diags
            m.tool_nodiags.put(spec.tag, true)
        m.queue.add(spec)
        if m.run == nil
            paneClear(m)
            startNextGate(m)
    else
        m.status = "tool " + t.name + ": no file open"

def runHooks(m: Model, event: str)
    if m.manifest as mf
        for t in mf.hooks(event)
            runTool(m, t)

# ── Debugger ─────────────────────────────────────────────────────────────────
def dbgPane(m: Model, text: str)
    m.dbg_pane!.setReadOnly(false)
    m.dbg_pane!.setText(text)
    m.dbg_pane!.setReadOnly(true)

def debugStart(m: Model)
    if m.dbg != nil
        m.status = "a debug session is already running"
        return
    if m.bufs.cur() as b
        if not b.path.endsWith(".zbr")
            m.status = "debug: the current buffer is not a .zbr program"
            return
        File.write(b.path, m.editor!.getText())          # debug what is on screen
        m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
        var stem: str = baseName(b.path)
        stem = stem[0..stem.len - 4]
        var exe: str = sys.cwd() + "/" + stem              # zig build-exe writes to the cwd
        if sys.getenv("OS") != nil
            exe = exe + ".exe"
        var c = DapClient()
        if not c.start(compilerPath(), b.path, exe)
            m.status = "could not start `" + compilerPath() + " debug` (needs lldb-dap on PATH too)"
            return
        m.dbg = c
        m.dbg_src = b.path
        m.dbg_launched = false
        m.dbg_last_state = ""
        m.dbg_output_len = 0
        c.initialize()
        dbgPane(m, "starting zebra debug (compiling with debug info)…")
        m.status = "debug: starting"
    else
        m.status = "debug: no file open"

def debugEnd(m: Model, why: str)
    if m.dbg as c
        c.stop()
    m.dbg = nil
    m.editor!.sci(SCI_MARKERDELETEALL, MARKER_CURRENT, 0)
    m.status = "debug: " + why

def showFrames(m: Model, c: DapClient)
    var sb = StringBuilder()
    sb.append("stopped: " + c.stop_reason + "\n")
    for f in c.frames
        sb.append(baseName(f.path) + ":" + f.line.toString() + "  " + f.name + "\n")
    if m.dbg_vars_text != ""
        sb.append(m.dbg_vars_text)
    if c.output.len > 0
        sb.append("── output ──\n" + c.output)
    dbgPane(m, sb.build())
    m.editor!.sci(SCI_MARKERDELETEALL, MARKER_CURRENT, 0)
    if c.frames.len > 0
        var top: DapFrame = c.frames.at(0)
        if top.path != "" and top.path.endsWith(".zbr")
            if m.bufs.cur() as cb
                # Same file iff one path is a suffix of the other (the relay reports
                # paths relative to its cwd, the buffer holds what was opened). A
                # basename match alone is NOT enough — two same-named files in
                # different directories are different files (refuter, 2026-09-07).
                var same_file: bool = false
                var np: str = top.path.replace("\\", "/")
                var cp: str = cb.path.replace("\\", "/")
                if cp == np or cp.endsWith("/" + np) or np.endsWith("/" + cp)
                    same_file = true
                if not same_file
                    var p: str = top.path
                    if not File.exists(p)
                        p = joinPath(sys.cwd(), top.path)
                    if File.exists(p)
                        same_file = openFile(m, p)
                    else
                        m.status = "debug: stopped in " + top.path + ", which is not open here"
                if same_file
                    gotoLineCol(m.editor!, top.line - 1, 0)
                    m.editor!.sci(SCI_MARKERADD, top.line - 1, MARKER_CURRENT)

def pollDebug(m: Model)
    if m.dbg as c
        c.poll()
        if c.state == "ended"
            var tail: str = ""
            if c.output.len > 0
                tail = "\n── output ──\n" + c.output
            if not m.dbg_launched
                # the relay died before the session started: its stderr says why
                # (no lldb-dap on PATH, compile error) — show it, do not bury it
                # under "exit -1" (advocate finding 6)
                dbgPane(m, "zebra debug did not start:\n" + c.log().join("\n"))
                debugEnd(m, "could not start — see the debugger pane")
                return
            dbgPane(m, "session ended (exit " + c.exit_code.toString() + ")" + tail)
            debugEnd(m, "ended, exit " + c.exit_code.toString())
            return
        # after initialize: launch, breakpoints, configurationDone — once
        if not m.dbg_launched and c.initialized_evt == false
            var seqs: List(int) = List(int)()
            # the initialize reply is what tells us the relay is alive; find it
            var got_init: bool = false
            for k in c.replies.keys()
                if c.takeReply(k) as r
                    if r.getStr("command") == "initialize"
                        got_init = true
            if got_init
                c.launch()
                c.setBreakpoints(m.dbg_src, markerLines(m.editor!, MARKER_BREAK))
                c.configurationDone()
                m.dbg_launched = true
                m.status = "debug: launched"
        if c.state == "stopped" and m.dbg_last_state != "stopped"
            m.dbg_last_state = "stopped"
            m.dbg_frames_id = c.stackTrace()
        if c.state == "running" and m.dbg_last_state != "running"
            m.dbg_last_state = "running"
            m.editor!.sci(SCI_MARKERDELETEALL, MARKER_CURRENT, 0)
            m.status = "debug: running"
        if m.dbg_frames_id != 0
            if c.takeReply(m.dbg_frames_id) as r
                m.dbg_frames_id = 0
                c.readFrames(r)
                m.dbg_vars_text = ""
                m.dbg_var_req = HashMap(int, str)()
                if c.frames.len > 0
                    m.dbg_scopes_id = c.scopes(c.frames.at(0).id)
                showFrames(m, c)
                m.status = "debug: stopped (" + c.stop_reason + ")"
        # variables pane: scopes of the top frame, then each scope's variables, rendered
        # under the frames as they arrive (Locals is empty for Zig programs and says so)
        if m.dbg_scopes_id != 0
            if c.takeReply(m.dbg_scopes_id) as sr
                m.dbg_scopes_id = 0
                for sc in c.readScopes(sr)
                    m.dbg_var_req.put(c.variables(sc.ref), sc.name)
        if m.dbg_var_req.count() > 0
            var done_ids: List(int) = List(int)()
            for vid in m.dbg_var_req.keys()
                if c.takeReply(vid) as vr
                    var vars: List(DapVar) = c.readVariables(vr)
                    var sname: str = m.dbg_var_req.fetch(vid)
                    var vsb = StringBuilder()
                    vsb.append("── " + sname + " (" + vars.len.toString() + ")")
                    if vars.len == 0 and sname == "Locals"
                        vsb.append(" — empty: lldb has no Zig plugin; Globals and Registers are real")
                    vsb.append("\n")
                    var shown: int = 0
                    for v in vars
                        if shown >= 40
                            vsb.append("  … " + (vars.len - shown).toString() + " more\n")
                            break
                        vsb.append("  " + v.name + " = " + v.value)
                        if v.kind != ""
                            vsb.append("  : " + v.kind)
                        vsb.append("\n")
                        shown = shown + 1
                    m.dbg_vars_text = m.dbg_vars_text + vsb.build()
                    done_ids.add(vid)
            if done_ids.len > 0
                for did in done_ids
                    m.dbg_var_req.remove(did)
                if c.state == "stopped"
                    showFrames(m, c)
        if c.output.len != m.dbg_output_len and c.state == "running"
            m.dbg_output_len = c.output.len
            dbgPane(m, "running…\n── output ──\n" + c.output)

# Every ~100 ms: poll the server, push edits after a quiet spell, apply replies.
def tick(m: Model)
    if not m.overlay_ready
        # view() has rendered once by the time the first tick is processed, so
        # the native control exists and accepts messages (on tui they are no-ops).
        configureOverlay(m.editor!)
        m.base_doc = m.editor!.sci(SCI_GETDOCPOINTER, 0, 0)
        if m.base_doc != 0
            m.editor!.sci(SCI_ADDREFDOCUMENT, 0, m.base_doc)
        # files given on the command line were opened before the control existed:
        # give each its own document now (their text is still in the Buffers)
        var k: int = 0
        while k < m.bufs.count()
            var bk: Buffer = m.bufs.items.at(k)
            if bk.docptr == 0
                bk.docptr = m.editor!.sci(SCI_CREATEDOCUMENT, 0, 0)
                if bk.docptr != 0
                    m.editor!.sci(SCI_SETDOCPOINTER, 0, bk.docptr)
                    m.editor!.setLanguage(bk.lang)
                    m.editor!.setText(bk.text)
                    m.editor!.sci(SCI_EMPTYUNDOBUFFER, 0, 0)
                    m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
            k = k + 1
        if m.bufs.count() > 0
            showBuffer(m, m.bufs.current)
        m.overlay_ready = true
    m.tick_n = m.tick_n + 1
    # events from the notify bridge (no-ops on tui)
    if m.editor!.takeCharAdded() == 10
        autoIndent(m)
    var clicked: int = m.editor!.takeMarginClick()
    if clicked >= 0
        toggleMarker(m.editor!, clicked, MARKER_BREAK)
        if m.dbg as dc0
            if m.bufs.cur() as cb0
                if dc0.state == "stopped"
                    dc0.setBreakpoints(cb0.path, markerLines(m.editor!, MARKER_BREAK))
    var modified: bool = m.editor!.takeModified()
    pollGates(m)
    pollDebug(m)
    if m.servers.count() == 0
        return
    # every server: drain its pipe; once it is initialized, open the buffers of its
    # language it has not seen (late initialize)
    for lang in m.servers.keys()
        var sc: LspClient = m.servers.fetch(lang)
        sc.poll()
        if sc.initialized
            var oi: int = 0
            while oi < m.bufs.count()
                var ob: Buffer = m.bufs.items.at(oi)
                if not ob.opened_lsp and ob.lang == lang
                    var otext: str = ob.text
                    if oi == m.bufs.current
                        otext = m.editor!.getText()
                    sc.didOpen(ob.uri, ob.lang, ob.version, otext)
                    ob.last_sent = otext
                    ob.opened_lsp = true
                oi = oi + 1
    var copt: LspClient? = lspCur(m)
    if copt == nil
        return
    var c: LspClient = copt!
    if m.bufs.cur() as cb
        if modified or m.tick_n % 10 == 0 or m.pending_text != cb.last_sent
            var now: str = m.editor!.getText()
            if now != m.pending_text
                m.pending_text = now
                m.quiet = 0
            else if now != cb.last_sent
                m.quiet = m.quiet + 1
                if m.quiet >= DIRTY_TICKS
                    cb.version = cb.version + 1
                    c.didChange(cb.uri, cb.version, now)
                    cb.last_sent = now
                    m.quiet = 0
        if c.diagnostics.get(cb.uri) as ds
            applyDiagnostics(m, ds)
            cb.errors = m.errors
            cb.warnings = m.warnings
            c.diagnostics.remove(cb.uri)      # consumed; the next publish re-arms
    # replies: on the server the request went to (ids are per server; the user may
    # have switched to a buffer of another language meanwhile)
    var ropt: LspClient? = lspFor(m, m.req_lang)
    if ropt == nil
        return
    var rc: LspClient = ropt!
    if m.def_id != 0
        if rc.takeReply(m.def_id) as r
            m.def_id = 0
            var locs: List(LspLocation) = rc.locations(r)
            if locs.len == 0
                m.status = "no definition"
            else
                var target: LspLocation = locs.at(0)
                var here: bool = true
                if m.bufs.cur() as cb2
                    if target.uri != cb2.uri
                        here = openFile(m, pathOfUri(target.uri))
                if here
                    gotoLineCol(m.editor!, target.line, target.col)
                    m.status = "definition: " + baseName(pathOfUri(target.uri)) + ":" + (target.line + 1).toString()
    if m.refs_id != 0
        if rc.takeReply(m.refs_id) as r
            m.refs_id = 0
            var locs: List(LspLocation) = rc.locations(r)
            var sb = StringBuilder()
            m.ref_lines = List(int)()
            m.ref_uris = List(str)()
            for l in locs
                sb.append(baseName(pathOfUri(l.uri)) + ":" + (l.line + 1).toString() + ":" + (l.col + 1).toString() + "\n")
                m.ref_lines.add(l.line)
                m.ref_uris.add(l.uri)
            m.refs!.setReadOnly(false)
            m.refs!.setText(sb.build())
            m.refs!.setReadOnly(true)
            m.status = locs.len.toString() + " reference(s)"
    if m.sym_id != 0
        if rc.takeReply(m.sym_id) as r
            m.sym_id = 0
            m.sym_lines = List(int)()
            var outline_text: str = symbolLines(r, m.sym_lines)
            m.outline!.setReadOnly(false)
            m.outline!.setText(outline_text)
            m.outline!.setReadOnly(true)
            m.status = m.sym_lines.len.toString() + " symbol(s)"
    if m.rename_id != 0
        if rc.takeReply(m.rename_id) as r
            m.rename_id = 0
            var res = r.at("result")
            if res.isNull() or res.at("changes").isNull()
                m.status = "rename: server returned no edits"
            else
                m.status = applyWorkspaceEdit(m, res.getObj("changes"))

def update(m: Model, msg: Msg): Model
    branch msg
        on Msg.tick
            tick(m)
            # claimed chords, in order, each as the Msg it means
            var k: int = m.editor!.takeKey()
            var kn: int = 0
            while k != 0 and kn < 16
                if shortcutMsg(k, m.dbg != nil) as km
                    var back: Model = update(m, km)     # Model is a class: `back` IS m
                    assert back == m
                k = m.editor!.takeKey()
                kn = kn + 1
            return m
        on Msg.open_file
            return m        # dialog result is delivered through Msg by view (button-gated there)
        on Msg.save_file
            if m.bufs.cur() as sb
                File.write(sb.path, m.editor!.getText())
                m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
                m.status = "saved " + baseName(sb.path)
                runHooks(m, "save")
                if m.manifest as mfs
                    if mfs.tests_on_save and sb.path.endsWith(".zbr") and m.run == nil
                        startTests(m, List(str)())
            else
                m.status = "nothing to save"
            return m
        on Msg.run_tool as ti
            if m.manifest as mf
                var bl: List(ToolSpec) = mf.buttons()
                if ti >= 0 and ti < bl.len
                    runTool(m, bl.at(ti))
            return m
        on Msg.select_tab as ti
            switchTo(m, ti)
            return m
        on Msg.close_tab
            # unsaved changes: refuse once and say so; a second Close discards (advocate 9)
            if m.editor!.sci(SCI_GETMODIFY, 0, 0) != 0 and m.close_armed != m.bufs.current
                m.close_armed = m.bufs.current
                m.status = "unsaved changes — Save, or press Close again to discard them"
                return m
            m.close_armed = -1
            closeCurrent(m)
            return m
        on Msg.reload_manifest
            loadProject(m)
            return m
        on Msg.build
            if m.run != nil
                m.status = "a gate is still running"
                return m
            if m.manifest as mf
                if mf.build as bspec
                    paneClear(m)
                    m.gates_done = 0
                    m.gates_failed = 0
                    m.gates_skipped = 0
                    m.queue = List(GateSpec)()
                    m.queue.add(bspec)
                    m.summary_pending = true
                    startNextGate(m)
                else
                    m.status = "manifest has no build entry"
            else
                m.status = "no project loaded (zebra-ide.json)"
            return m
        on Msg.run_gates
            if m.run != nil
                m.status = "a gate is still running"
                return m
            if m.manifest as mf
                paneClear(m)
                m.gates_done = 0
                m.gates_failed = 0
                m.gates_skipped = 0
                m.queue = List(GateSpec)()
                for g in mf.gates
                    m.queue.add(g)
                if m.queue.len == 0
                    m.status = "manifest has no gates"
                m.summary_pending = true
                startNextGate(m)
            else
                m.status = "no project loaded (zebra-ide.json)"
            return m
        on Msg.toggle_bookmark
            toggleMarker(m.editor!, cursorLine(m.editor!), MARKER_BOOKMARK)
            return m
        on Msg.toggle_breakpoint
            # the margin click needs the notify bridge, which is absent at the shipped
            # zig-libui-ng pin (advocate finding 1) — the button always works
            toggleMarker(m.editor!, cursorLine(m.editor!), MARKER_BREAK)
            if m.dbg as dcb
                if m.bufs.cur() as cbb
                    if dcb.state == "stopped"
                        dcb.setBreakpoints(cbb.path, markerLines(m.editor!, MARKER_BREAK))
            return m
        on Msg.debug_start
            debugStart(m)
            return m
        on Msg.debug_continue
            if m.dbg as c
                if c.state == "stopped"
                    c.continue_()
            return m
        on Msg.debug_next
            if m.dbg as c
                if c.state == "stopped"
                    c.next()
            return m
        on Msg.debug_step_in
            if m.dbg as c
                if c.state == "stopped"
                    c.stepIn()
            return m
        on Msg.debug_step_out
            if m.dbg as c
                if c.state == "stopped"
                    c.stepOut()
            return m
        on Msg.debug_stop
            if m.dbg as c
                c.disconnect()
            debugEnd(m, "stopped by user")
            return m
        on Msg.jump_frame
            if m.dbg as c
                var i: int = cursorLine(m.dbg_pane!) - 1     # line 0 is the "stopped:" header
                if i >= 0 and i < c.frames.len
                    var f: DapFrame = c.frames.at(i)
                    if f.path.endsWith(".zbr")
                        gotoLineCol(m.editor!, f.line - 1, 0)
            return m
        on Msg.find_next
            findNext(m)
            return m
        on Msg.replace_one
            replaceOne(m)
            return m
        on Msg.replace_all
            replaceAll(m)
            return m
        on Msg.run_file
            runCurrentFile(m)
            return m
        on Msg.run_tests
            startTests(m, List(str)())
            return m
        on Msg.rerun_failed_tests
            if m.tests as t
                var fl: List(str) = t.failedLabels()
                if fl.len == 0
                    m.status = "tests: nothing failed in the last run"
                else
                    startTests(m, fl)
            else
                m.status = "tests: run them first"
            return m
        on Msg.jump_test
            var ti: int = cursorLine(m.tests_pane!)
            if m.tests as t
                if ti < m.tests_jumps.len and m.tests_jumps.at(ti) > 0
                    if openFile(m, t.file)
                        gotoLineCol(m.editor!, m.tests_jumps.at(ti) - 1, 0)
            return m
        on Msg.jump_diag
            var i: int = cursorLine(m.gate_pane!)
            if i < m.pane_diag_idx.len and m.pane_diag_idx.at(i) >= 0
                var d: Diag = m.pane_diag.at(m.pane_diag_idx.at(i))
                var root: str = "."
                if m.manifest as mf
                    root = mf.root
                var full: str = joinPath(root, d.path)
                if not File.exists(full)
                    full = d.path
                if openFile(m, full)
                    var col: int = 0
                    if d.col > 0
                        col = d.col - 1
                    gotoLineCol(m.editor!, d.line - 1, col)
            return m
        on Msg.goto_def
            if lspCur(m) as c
                if m.bufs.cur() as b
                    m.req_lang = b.lang
                    m.def_id = c.definition(b.uri, cursorLine(m.editor!), cursorCol(m.editor!))
            return m
        on Msg.find_refs
            if lspCur(m) as c
                if m.bufs.cur() as b
                    m.req_lang = b.lang
                    m.refs_id = c.references(b.uri, cursorLine(m.editor!), cursorCol(m.editor!))
            return m
        on Msg.symbols
            if lspCur(m) as c
                if m.bufs.cur() as b
                    m.req_lang = b.lang
                    m.sym_id = c.documentSymbol(b.uri)
            return m
        on Msg.rename
            if m.new_name == ""
                m.status = "rename: type the new name first"
                return m
            if lspCur(m) as c
                if m.bufs.cur() as b
                    m.req_lang = b.lang
                    # `zebra lsp` (09-08) resolves the `use` graph from disk itself:
                    # the modules this file uses + same-directory dependents, whether
                    # or not they are open. (An earlier version shadow-opened every
                    # .zbr in the root here; that typechecked each one on every
                    # rename, which on selfhost/ would have cost a minute.)
                    m.rename_id = c.rename(b.uri, cursorLine(m.editor!), cursorCol(m.editor!), m.new_name)
            return m
        on Msg.jump_ref
            var i: int = cursorLine(m.refs!)
            if i < m.ref_lines.len
                var here2: bool = true
                if m.bufs.cur() as b
                    if m.ref_uris.at(i) != b.uri
                        here2 = openFile(m, pathOfUri(m.ref_uris.at(i)))
                if here2
                    gotoLineCol(m.editor!, m.ref_lines.at(i), 0)
            return m
        on Msg.jump_sym
            var i: int = cursorLine(m.outline!)
            if i < m.sym_lines.len
                gotoLineCol(m.editor!, m.sym_lines.at(i), 0)
            return m
        on Msg.next_bookmark
            var from: int = cursorLine(m.editor!) + 1
            var nxt: int = m.editor!.sci(SCI_MARKERNEXT, from, 8)
            if nxt < 0
                nxt = m.editor!.sci(SCI_MARKERNEXT, 0, 8)
            if nxt >= 0
                gotoLineCol(m.editor!, nxt, 0)
            return m

def view(g: Gui, m: Model)
    g.send(Msg.tick)
    using g.vbox("##root", true)
        using g.hbox("##toolbar", false)
            if g.button("Open…")
                var p = g.openFile()
                if p as path
                    if not openFile(m, path)
                        pass
            if g.button("Save")
                g.send(Msg.save_file)
            if g.button("Definition")
                g.send(Msg.goto_def)
            if g.button("References")
                g.send(Msg.find_refs)
            if g.button("Symbols")
                g.send(Msg.symbols)
            m.new_name = g.input("new name", m.new_name)
            if g.button("Rename")
                g.send(Msg.rename)
            if g.button("Next bookmark")
                g.send(Msg.next_bookmark)
            if g.button("Close")
                g.send(Msg.close_tab)
            if g.button("Build")
                g.send(Msg.build)
            if g.button("Run gates")
                g.send(Msg.run_gates)
            if g.button("Run")
                g.send(Msg.run_file)
            if g.button("Run tests")
                g.send(Msg.run_tests)
            if g.button("Re-run failed")
                g.send(Msg.rerun_failed_tests)
            if g.button("Reload project")
                g.send(Msg.reload_manifest)
            # Tools row: the manifest's process plugins (buttons; hooks run on save/open)
            if m.manifest as mft
                var tools: List(ToolSpec) = mft.buttons()
                var ti: int = 0
                while ti < tools.len
                    if g.buttonId("##tool:" + tools.at(ti).name, tools.at(ti).label)
                        g.send(Msg.run_tool(ti))
                    ti = ti + 1
            if g.button("Bookmark")
                g.send(Msg.toggle_bookmark)
        using g.hbox("##findbar", false)
            m.find_text = g.input("find", m.find_text)
            if g.button("Find next")
                g.send(Msg.find_next)
            m.replace_text = g.input("replace", m.replace_text)
            if g.button("Replace")
                g.send(Msg.replace_one)
            if g.button("Replace all")
                g.send(Msg.replace_all)
        using g.hbox("##debugbar", false)
            if g.button("Breakpoint")
                g.send(Msg.toggle_breakpoint)
            if g.button("Debug")
                g.send(Msg.debug_start)
            if g.button("Continue")
                g.send(Msg.debug_continue)
            if g.button("Next")
                g.send(Msg.debug_next)
            if g.button("Step in")
                g.send(Msg.debug_step_in)
            if g.button("Step out")
                g.send(Msg.debug_step_out)
            if g.button("Stop")
                g.send(Msg.debug_stop)
            if g.button("Jump to frame")
                g.send(Msg.jump_frame)
        # tab row: one button per open file, keyed by PATH (not slot) so closing a
        # middle tab hides its own button and the rest keep their identity
        using g.hbox("##tabs", false)
            var dirty_now: bool = m.editor!.sci(SCI_GETMODIFY, 0, 0) != 0
            var t: int = 0
            while t < m.bufs.count()
                var lbl: str = m.bufs.label(t, dirty_now and t == m.bufs.current)
                if t == m.bufs.current
                    lbl = "[" + lbl + "]"
                if g.buttonId("##tab:" + m.bufs.items.at(t).path, lbl)
                    g.send(Msg.select_tab(t))
                t = t + 1
        g.separator()
        using g.hbox("##body", true)
            m.editor!.render(g, "##code", 0, 0)
            using g.vbox("##side", false)
                g.text("References")
                m.refs!.render(g, "##refs", 0, 0)
                if g.button("Jump to reference")
                    g.send(Msg.jump_ref)
                g.text("Symbols")
                m.outline!.render(g, "##syms", 0, 0)
                if g.button("Jump to symbol")
                    g.send(Msg.jump_sym)
        using g.hbox("##bottom", false)
            using g.vbox("##gatesbox", true)
                g.text("Build / gates")
                m.gate_pane!.render(g, "##gates", 0, 0)
                if g.button("Jump to diagnostic")
                    g.send(Msg.jump_diag)
            using g.vbox("##testsbox", true)
                g.text("Tests")
                m.tests_pane!.render(g, "##tests", 0, 0)
                if g.button("Jump to test")
                    g.send(Msg.jump_test)
            using g.vbox("##dbgbox", true)
                g.text("Debugger")
                m.dbg_pane!.render(g, "##dbg", 0, 0)
        g.separator()
        var dirty: str = ""
        if m.editor!.sci(SCI_GETMODIFY, 0, 0) != 0
            dirty = " *"
        var lsp_s: str = "no lsp"
        if m.servers.count() > 0
            var parts: List(str) = List(str)()
            for sl in m.servers.keys()
                var lc: LspClient = m.servers.fetch(sl)
                if lc.initialized
                    parts.add(serverLabel(sl))
                else
                    parts.add(serverLabel(sl) + " starting…")
            lsp_s = parts.join(" · ")
        var cur_path: str = ""
        if m.bufs.cur() as vb
            cur_path = vb.path
        g.text(cur_path + dirty + "   Ln " + (cursorLine(m.editor!) + 1).toString() + ", Col " + (cursorCol(m.editor!) + 1).toString()
               + "   " + m.editor!.getLanguage() + "   " + lsp_s + "   errors " + m.errors.toString() + "  warnings " + m.warnings.toString()
               + "   " + m.status)

def main()
    var args: List(str) = sys.args()
    var ai: int = 1
    while ai < args.len
        startup_files.add(args.at(ai))
        ai = ai + 1
    Gui.run("zebra-ide", 1200, 800, ideInit, update, view)
