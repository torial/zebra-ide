# ide.zbr — zebra-ide, the program. Zebra + libui-ng + Scintilla + `zebra lsp`.
#
#   zebra --gui-backend=libui_ng src/ide.zbr        (deps beside the source)
#   zebra --gui-backend=tui       src/ide.zbr        (compile control; editors are stubs)
#
# What this file is: the first slice that is an IDE rather than an editor —
# one document, live diagnostics from the language server drawn as squiggles
# and margin markers, go-to-definition, find-references, document symbols and
# rename, all through two things that already exist: the LSP client (lsp.zbr)
# and the raw Scintilla hatch (editor.sci / sciStr; ids in sci.zbr). No new
# compiler builtins were needed for anything on this page.
#
# Shape (MVU, see QUICKSTART §30): the Model is a CLASS (mutated in place; a
# struct would be copied into update and the edits lost), widgets are created on
# frame 0 and only their contents change afterwards (libui is retained-mode:
# the count and order of g.text/button/editor calls must be the same every
# frame). view() sends Msg.tick every frame; update(tick) is where the LSP is
# polled, dirty text is pushed, replies are applied. Nothing blocks.
#
# Panes are editors: the references list and the symbol outline are read-only
# CodeEditors (language "text"). "Jump" reads the pane's cursor line and goes
# there. This is deliberate: it needs no list widget, and lines are already
# the unit everything else speaks (Scintilla, LSP, the compiler's diagnostics).
#
# Known limits, stated rather than hidden:
#   * many documents in ONE Scintilla control via document pointers (plan P2):
#     each Buffer owns an SCI_CREATEDOCUMENT; switching is SCI_SETDOCPOINTER,
#     which keeps undo history per document; caret/scroll are saved by hand.
#     Tabs are a fixed row of MAX_TABS g.buttonId buttons (uiTab cannot relabel).
#   * no keyboard shortcuts: libui exposes no key events for Scintilla, and
#     Scintilla's own SCI_ASSIGNCMDKEY only maps keys to Scintilla commands;
#   * events arrive through the notify bridge (editor.takeModified /
#     takeCharAdded / takeMarginClick, fed by uiScintillaOnNotify in
#     zig-libui-ng's libui_scintilla/win.cxx); the text compare is kept as a
#     1-in-10-ticks fallback so the tui backend (no events) still works.

use lsp exposing LspClient, LspLocation, LspDiagnostic, jsonEscape
use buffers exposing Buffer, BufferSet, uriOf, pathOfUri, langOf, baseName, MAX_TABS
use sci exposing SCI_GOTOPOS, SCI_GOTOLINE, SCI_GETCURRENTPOS, SCI_LINEFROMPOSITION, SCI_GETCOLUMN, SCI_POSITIONFROMLINE, SCI_GETLENGTH, SCI_INDICSETSTYLE, SCI_INDICSETFORE, SCI_SETINDICATORCURRENT, SCI_INDICATORFILLRANGE, SCI_INDICATORCLEARRANGE, SCI_MARKERDEFINE, SCI_MARKERSETBACK, SCI_MARKERSETFORE, SCI_MARKERADD, SCI_MARKERDELETEALL, SCI_SETMARGINWIDTHN, SCI_SETMARGINTYPEN, SCI_SETMARGINMASKN, SCI_SETSAVEPOINT, SCI_GETMODIFY, SCI_ANNOTATIONSETTEXT, SCI_ANNOTATIONSETSTYLE, SCI_ANNOTATIONCLEARALL, SCI_ANNOTATIONSETVISIBLE, SCI_SCROLLCARET, SCI_STYLESETFORE, SCI_STYLESETBACK, SCI_STYLESETITALIC, INDIC_SQUIGGLE, SC_MARK_SHORTARROW, SC_MARK_CIRCLE, SC_MARK_BOOKMARK, SC_MARGIN_SYMBOL, ANNOTATION_BOXED, SCI_REPLACESEL, SCI_MARKERNEXT, SCI_MARKERGET, SCI_MARKERDELETE, SCI_SETMARGINSENSITIVEN, SCI_GETLINECOUNT, SCI_CREATEDOCUMENT, SCI_ADDREFDOCUMENT, SCI_RELEASEDOCUMENT, SCI_GETDOCPOINTER, SCI_SETDOCPOINTER, SCI_GETFIRSTVISIBLELINE, SCI_SETFIRSTVISIBLELINE, SCI_EMPTYUNDOBUFFER

# ── Constants of this program ──────────────────────────────────────────────
const INDIC_ERROR: int = 8          # indicator slots 8..31 are free for containers
const INDIC_WARN: int = 9
const MARKER_ERROR: int = 1         # marker numbers; 0 is left to the debugger phase
const MARKER_WARN: int = 2
const MARGIN_MARKS: int = 1         # margin 0 = line numbers (set by the editor); 1 = ours
const DIRTY_TICKS: int = 3          # ticks (~100 ms each) of quiet before didChange
const STYLE_ANNOT: int = 40         # style slot for inline diagnostic annotations
const MARKER_BOOKMARK: int = 3      # toggled by clicking the marker margin

class Model
    var editor: CodeEditor? = nil
    var refs: CodeEditor? = nil          # references pane (read-only)
    var outline: CodeEditor? = nil       # symbols pane (read-only)
    var lsp: LspClient? = nil
    var bufs: BufferSet
    var status: str = "no file"
    var pending_text: str = ""           # text seen last tick (for quiet detection)
    var quiet: int = 0
    var base_doc: int = 0                # the control's original document (kept alive, unused)
    var def_id: int = 0
    var refs_id: int = 0
    var sym_id: int = 0
    var rename_id: int = 0
    var ref_lines: List(int)             # pane line -> source line (0-based)
    var ref_uris: List(str)
    var sym_lines: List(int)
    var new_name: str = ""
    var lsp_ok: bool = false
    var errors: int = 0
    var warnings: int = 0
    var overlay_ready: bool = false      # Scintilla exists only after the first render
    var tick_n: int = 0

    cue init()
        .ref_lines = List(int)()
        .ref_uris = List(str)()
        .sym_lines = List(int)()
        .bufs = BufferSet()

union Msg
    tick
    open_file
    save_file
    goto_def
    find_refs
    symbols
    rename
    jump_ref
    jump_sym
    next_bookmark
    select_tab: int
    close_tab

# ── Helpers ────────────────────────────────────────────────────────────────
def cursorLine(ed: CodeEditor): int
    var pos: int = ed.sci(SCI_GETCURRENTPOS, 0, 0)
    return ed.sci(SCI_LINEFROMPOSITION, pos, 0)

def cursorCol(ed: CodeEditor): int
    var pos: int = ed.sci(SCI_GETCURRENTPOS, 0, 0)
    return ed.sci(SCI_GETCOLUMN, pos, 0)

def gotoLineCol(ed: CodeEditor, line: int, col: int)
    var pos: int = ed.sci(SCI_POSITIONFROMLINE, line, 0) + col
    ed.sci(SCI_GOTOPOS, pos, 0)
    ed.sci(SCI_SCROLLCARET, 0, 0)

# One-time Scintilla setup for the diagnostics overlay. Colours are 0xBBGGRR.
def configureOverlay(ed: CodeEditor)
    ed.sci(SCI_INDICSETSTYLE, INDIC_ERROR, INDIC_SQUIGGLE)
    ed.sci(SCI_INDICSETFORE, INDIC_ERROR, 0x5c5ce0)      # #e05c5c
    ed.sci(SCI_INDICSETSTYLE, INDIC_WARN, INDIC_SQUIGGLE)
    ed.sci(SCI_INDICSETFORE, INDIC_WARN, 0x4fb8e0)       # #e0b84f
    ed.sci(SCI_MARKERDEFINE, MARKER_ERROR, SC_MARK_SHORTARROW)
    ed.sci(SCI_MARKERSETBACK, MARKER_ERROR, 0x5c5ce0)
    ed.sci(SCI_MARKERSETFORE, MARKER_ERROR, 0x5c5ce0)
    ed.sci(SCI_MARKERDEFINE, MARKER_WARN, SC_MARK_CIRCLE)
    ed.sci(SCI_MARKERSETBACK, MARKER_WARN, 0x4fb8e0)
    ed.sci(SCI_MARKERSETFORE, MARKER_WARN, 0x4fb8e0)
    ed.sci(SCI_SETMARGINTYPEN, MARGIN_MARKS, SC_MARGIN_SYMBOL)
    ed.sci(SCI_SETMARGINWIDTHN, MARGIN_MARKS, 16)
    ed.sci(SCI_SETMARGINMASKN, MARGIN_MARKS, 14)           # bits for markers 1, 2, 3
    ed.sci(SCI_SETMARGINSENSITIVEN, MARGIN_MARKS, 1)       # clicks arrive as SCN_MARGINCLICK
    ed.sci(SCI_MARKERDEFINE, MARKER_BOOKMARK, SC_MARK_BOOKMARK)
    ed.sci(SCI_MARKERSETBACK, MARKER_BOOKMARK, 0xc2b656)
    ed.sci(SCI_ANNOTATIONSETVISIBLE, ANNOTATION_BOXED, 0)
    ed.sci(SCI_STYLESETFORE, STYLE_ANNOT, 0x9a9ad0)        # #d09a9a
    ed.sci(SCI_STYLESETBACK, STYLE_ANNOT, 0x2f2823)
    ed.sci(SCI_STYLESETITALIC, STYLE_ANNOT, 1)

# Draw the server's diagnostics for the current document: squiggles under each
# range, a marker in the margin, the message as a boxed annotation under the line.
def applyDiagnostics(m: Model, ds: List(LspDiagnostic))
    var ed: CodeEditor = m.editor!
    var n: int = ed.sci(SCI_GETLENGTH, 0, 0)
    ed.sci(SCI_SETINDICATORCURRENT, INDIC_ERROR, 0)
    ed.sci(SCI_INDICATORCLEARRANGE, 0, n)
    ed.sci(SCI_SETINDICATORCURRENT, INDIC_WARN, 0)
    ed.sci(SCI_INDICATORCLEARRANGE, 0, n)
    ed.sci(SCI_MARKERDELETEALL, MARKER_ERROR, 0)
    ed.sci(SCI_MARKERDELETEALL, MARKER_WARN, 0)
    ed.sci(SCI_ANNOTATIONCLEARALL, 0, 0)
    m.errors = 0
    m.warnings = 0
    for d in ds
        var is_err: bool = d.severity <= 1
        var start: int = ed.sci(SCI_POSITIONFROMLINE, d.line, 0) + d.col
        var stop: int = ed.sci(SCI_POSITIONFROMLINE, d.end_line, 0) + d.end_col
        if stop <= start
            stop = start + 1
        if is_err
            ed.sci(SCI_SETINDICATORCURRENT, INDIC_ERROR, 0)
            ed.sci(SCI_MARKERADD, d.line, MARKER_ERROR)
            m.errors = m.errors + 1
        else
            ed.sci(SCI_SETINDICATORCURRENT, INDIC_WARN, 0)
            ed.sci(SCI_MARKERADD, d.line, MARKER_WARN)
            m.warnings = m.warnings + 1
        ed.sci(SCI_INDICATORFILLRANGE, start, stop - start)
        ed.sciStr(SCI_ANNOTATIONSETTEXT, d.line, d.message)
        ed.sci(SCI_ANNOTATIONSETSTYLE, d.line, STYLE_ANNOT)

# Apply a WorkspaceEdit's edits for our uri to `text` (edits are applied from
# the end of the document backwards so earlier offsets stay valid).
def lineStartOffsets(text: str): List(int)
    var offs: List(int) = List(int)()
    offs.add(0)
    var i: int = 0
    while i < text.len
        if text[i..i+1] == "\n"
            offs.add(i + 1)
        i = i + 1
    return offs

def applyEdits(text: str, edits: JsonValue, uri: str): str
    var offs: List(int) = lineStartOffsets(text)
    # collect (start, end, newText) then sort by start descending (insertion sort; edits are few)
    var starts: List(int) = List(int)()
    var ends: List(int) = List(int)()
    var news: List(str) = List(str)()
    for e in edits.getList(uri)
        var rng = e.getObj("range")
        var s = rng.getObj("start")
        var en = rng.getObj("end")
        starts.add(offs.at(s.getInt("line")) + s.getInt("character"))
        ends.add(offs.at(en.getInt("line")) + en.getInt("character"))
        news.add(e.getStr("newText"))
    var order: List(int) = List(int)()
    var k: int = 0
    while k < starts.len
        order.add(k)
        k = k + 1
    var a: int = 1
    while a < order.len
        var b: int = a
        while b > 0 and starts.at(order.at(b - 1)) < starts.at(order.at(b))
            var tmp: int = order.at(b - 1)
            order.set(b - 1, order.at(b))
            order.set(b, tmp)
            b = b - 1
        a = a + 1
    var out: str = text
    for idx in order
        out = out[0..starts.at(idx)] + news.at(idx) + out[ends.at(idx)..out.len]
    return out

def symbolLines(reply: JsonValue, lines: List(int)): str
    # DocumentSymbol[] (nested) or SymbolInformation[] (flat); both carry a name and a range.
    # Returns the pane text (a StringBuilder parameter is const in Zebra — BUG-342).
    var sink = StringBuilder()
    for s in reply.getList("result")
        var line: int = 0
        if not s.at("location").isNull()
            line = s.getObj("location").getObj("range").getObj("start").getInt("line")
        else
            line = s.getObj("range").getObj("start").getInt("line")
        sink.append((line + 1).toString() + ": " + s.getStr("name") + "\n")
        lines.add(line)
    return sink.build()

# ── Model lifecycle ────────────────────────────────────────────────────────
def startLsp(m: Model)
    var zopt = sys.getenv("ZEBRA_COMPILER")
    if zopt == nil
        m.status = "ZEBRA_COMPILER not set — no language server"
        return
    var argv: List(str) = List(str)()
    argv.add(zopt!)
    argv.add("lsp")
    var c = LspClient()
    if not c.start("zebra", argv)
        m.status = "could not start zebra lsp"
        return
    m.lsp = c
    c.initialize(uriOf(sys.cwd()))
    m.lsp_ok = true

# ── Documents: one control, many Scintilla documents ─────────────────────────
# Save the view state Scintilla does not keep per document.
def saveView(m: Model)
    if m.bufs.cur() as b
        b.caret = m.editor!.sci(SCI_GETCURRENTPOS, 0, 0)
        b.first_line = m.editor!.sci(SCI_GETFIRSTVISIBLELINE, 0, 0)
        if b.docptr == 0
            b.text = m.editor!.getText()        # tui: the text lives in the Buffer

# Make buffer i current in the control. Works with docptr (libui) or text (tui).
def showBuffer(m: Model, i: int)
    var ed: CodeEditor = m.editor!
    var b: Buffer = m.bufs.items.at(i)
    m.bufs.current = i
    ed.setLanguage(b.lang)
    if b.docptr != 0
        ed.sci(SCI_SETDOCPOINTER, 0, b.docptr)
        ed.restyle()
    else
        ed.setText(b.text)
    ed.sci(SCI_GOTOPOS, b.caret, 0)
    ed.sci(SCI_SETFIRSTVISIBLELINE, b.first_line, 0)
    m.pending_text = ed.getText()
    m.quiet = 0
    m.errors = b.errors
    m.warnings = b.warnings
    if m.lsp as c
        if c.initialized and c.diagnostics.get(b.uri) == nil and b.opened_lsp
            c.diagnostics.put(b.uri, List(LspDiagnostic)())   # nothing pending: overlay stays as drawn
    # diagnostics for this document, if any arrived while it was hidden
    if m.lsp as c2
        if c2.diagnostics.get(b.uri) as ds
            applyDiagnostics(m, ds)
            c2.diagnostics.remove(b.uri)

def switchTo(m: Model, i: int)
    if i < 0 or i >= m.bufs.count() or i == m.bufs.current
        return
    saveView(m)
    showBuffer(m, i)

def openFile(m: Model, p: str)
    var existing: int = m.bufs.find(p)
    if existing >= 0
        switchTo(m, existing)
        m.status = "switched"
        return
    if not File.exists(p)
        m.status = "not found: " + p
        return
    if m.bufs.count() >= MAX_TABS
        m.status = "tab row is full (" + MAX_TABS.toString() + ") — close one first"
        return
    var text: str = File.read(p)
    saveView(m)
    var i: int = m.bufs.open(p, text)
    var b: Buffer = m.bufs.items.at(i)
    var ed: CodeEditor = m.editor!
    # A fresh Scintilla document (refcount 1, ours). On tui the hatch returns 0 and
    # the Buffer's text is the document.
    b.docptr = ed.sci(SCI_CREATEDOCUMENT, 0, 0)
    if b.docptr != 0
        ed.sci(SCI_SETDOCPOINTER, 0, b.docptr)
    ed.setLanguage(b.lang)
    ed.setText(text)
    ed.sci(SCI_EMPTYUNDOBUFFER, 0, 0)
    ed.sci(SCI_SETSAVEPOINT, 0, 0)
    m.bufs.current = i
    m.pending_text = text
    m.quiet = 0
    m.errors = 0
    m.warnings = 0
    if m.lsp as c
        if c.initialized
            c.didOpen(b.uri, b.lang, 1, text)
            b.opened_lsp = true
    m.status = "opened " + baseName(p)

def closeCurrent(m: Model)
    var i: int = m.bufs.current
    if i < 0
        return
    var b: Buffer = m.bufs.items.at(i)
    if m.lsp as c
        if b.opened_lsp
            c.didClose(b.uri)
    var doc: int = b.docptr
    m.bufs.close(i)
    if m.bufs.count() > 0
        showBuffer(m, m.bufs.current)
    else
        m.editor!.sci(SCI_SETDOCPOINTER, 0, m.base_doc)
        m.editor!.setText("")
        m.pending_text = ""
    if doc != 0
        m.editor!.sci(SCI_RELEASEDOCUMENT, 0, doc)
    m.status = "closed " + baseName(b.path)

def ideInit(): Model
    var m = Model()
    m.editor = CodeEditor.forZebra()
    m.refs = CodeEditor.forFile("references.txt")
    m.refs!.setReadOnly(true)
    m.refs!.setText("(references appear here)")
    m.outline = CodeEditor.forFile("symbols.txt")
    m.outline!.setReadOnly(true)
    m.outline!.setText("(symbols appear here)")
    startLsp(m)
    var args: List(str) = sys.args()
    var ai: int = 1
    while ai < args.len
        openFile(m, args.at(ai))
        ai = ai + 1
    return m

def isBlockOpener(lang: str, prev: str): bool
    var t: str = prev.trim()
    if lang == "zebra"
        for kw in ["def ", "if ", "else", "elif ", "while ", "for ", "class ", "struct ", "union ", "branch ", "on ", "using ", "cue ", "test ", "interface ", "enum ", "capture", "namespace "]
            if t.startsWith(kw) or t == kw.trim()
                return true
        return false
    return t.endsWith("{") or t.endsWith("(")

# On Enter: copy the previous line's indentation, plus one level after a block opener.
# Runs from the notify bridge (SCN_CHARADDED '\n'), so it costs nothing while idle.
def autoIndent(m: Model)
    var ed: CodeEditor = m.editor!
    var line: int = cursorLine(ed)
    if line <= 0
        return
    var text: str = ed.getText()
    var prev: str = ""
    var i: int = 0
    for l in text.split("\n")          # BUG-336: split().at() leaks Zig, so iterate
        if i == line - 1
            prev = l
        i = i + 1
    var indent: str = ""
    var k: int = 0
    while k < prev.len and (prev[k..k+1] == " " or prev[k..k+1] == "\t")
        indent = indent + prev[k..k+1]
        k = k + 1
    if isBlockOpener(ed.getLanguage(), prev)
        indent = indent + "    "
    if indent != ""
        ed.sciStr(SCI_REPLACESEL, 0, indent)

def toggleBookmark(ed: CodeEditor, line: int)
    var mask: int = ed.sci(SCI_MARKERGET, line, 0)
    if (mask / 8) % 2 == 1               # bit 3 set → marker 3 present
        ed.sci(SCI_MARKERDELETE, line, MARKER_BOOKMARK)
    else
        ed.sci(SCI_MARKERADD, line, MARKER_BOOKMARK)

# Apply a rename's WorkspaceEdit everywhere it points: open buffers are edited in
# their Scintilla documents (switching document pointers under the hood, view
# state restored); files that are not open are rewritten on disk and said so.
def applyWorkspaceEdit(m: Model, changes: JsonValue): str
    var start_idx: int = m.bufs.current
    var line: int = cursorLine(m.editor!)
    var col: int = cursorCol(m.editor!)
    var n_open: int = 0
    var n_disk: int = 0
    for u in changes.keys()
        var bi: int = m.bufs.findUri(u)
        if bi >= 0
            switchTo(m, bi)
            var edited: str = applyEdits(m.editor!.getText(), changes, u)
            m.editor!.setText(edited)
            n_open = n_open + 1
        else
            var p: str = pathOfUri(u)
            if File.exists(p)
                File.write(p, applyEdits(File.read(p), changes, u))
                n_disk = n_disk + 1
    if start_idx >= 0
        switchTo(m, start_idx)
        gotoLineCol(m.editor!, line, col)
    return "renamed in " + n_open.toString() + " open buffer(s), " + n_disk.toString() + " file(s) on disk"

# Every ~100 ms: poll the server, push edits after a quiet spell, apply replies.
def tick(m: Model)
    if not m.overlay_ready
        # view() has rendered once by the time the first tick is processed, so
        # the native control exists and accepts messages (on tui they are no-ops).
        configureOverlay(m.editor!)
        m.base_doc = m.editor!.sci(SCI_GETDOCPOINTER, 0, 0)
        if m.base_doc != 0
            m.editor!.sci(SCI_ADDREFDOCUMENT, 0, m.base_doc)
        # files given on the command line were opened before the control existed:
        # give each its own document now (their text is still in the Buffers)
        var k: int = 0
        while k < m.bufs.count()
            var bk: Buffer = m.bufs.items.at(k)
            if bk.docptr == 0
                bk.docptr = m.editor!.sci(SCI_CREATEDOCUMENT, 0, 0)
                if bk.docptr != 0
                    m.editor!.sci(SCI_SETDOCPOINTER, 0, bk.docptr)
                    m.editor!.setLanguage(bk.lang)
                    m.editor!.setText(bk.text)
                    m.editor!.sci(SCI_EMPTYUNDOBUFFER, 0, 0)
                    m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
            k = k + 1
        if m.bufs.count() > 0
            showBuffer(m, m.bufs.current)
        m.overlay_ready = true
    m.tick_n = m.tick_n + 1
    # events from the notify bridge (no-ops on tui)
    if m.editor!.takeCharAdded() == 10
        autoIndent(m)
    var clicked: int = m.editor!.takeMarginClick()
    if clicked >= 0
        toggleBookmark(m.editor!, clicked)
    var modified: bool = m.editor!.takeModified()
    if m.lsp == nil
        return
    var c: LspClient = m.lsp!
    c.poll()
    # late initialize: open every buffer the server has not seen
    if c.initialized
        var oi: int = 0
        while oi < m.bufs.count()
            var ob: Buffer = m.bufs.items.at(oi)
            if not ob.opened_lsp
                var otext: str = ob.text
                if oi == m.bufs.current
                    otext = m.editor!.getText()
                c.didOpen(ob.uri, ob.lang, ob.version, otext)
                ob.last_sent = otext
                ob.opened_lsp = true
            oi = oi + 1
    if m.bufs.cur() as cb
        if modified or m.tick_n % 10 == 0 or m.pending_text != cb.last_sent
            var now: str = m.editor!.getText()
            if now != m.pending_text
                m.pending_text = now
                m.quiet = 0
            else if now != cb.last_sent
                m.quiet = m.quiet + 1
                if m.quiet >= DIRTY_TICKS
                    cb.version = cb.version + 1
                    c.didChange(cb.uri, cb.version, now)
                    cb.last_sent = now
                    m.quiet = 0
        if c.diagnostics.get(cb.uri) as ds
            applyDiagnostics(m, ds)
            cb.errors = m.errors
            cb.warnings = m.warnings
            c.diagnostics.remove(cb.uri)      # consumed; the next publish re-arms
    if m.def_id != 0
        if c.takeReply(m.def_id) as r
            m.def_id = 0
            var locs: List(LspLocation) = c.locations(r)
            if locs.len == 0
                m.status = "no definition"
            else
                var target: LspLocation = locs.at(0)
                if m.bufs.cur() as cb2
                    if target.uri != cb2.uri
                        openFile(m, pathOfUri(target.uri))
                gotoLineCol(m.editor!, target.line, target.col)
                m.status = "definition: " + baseName(pathOfUri(target.uri)) + ":" + (target.line + 1).toString()
    if m.refs_id != 0
        if c.takeReply(m.refs_id) as r
            m.refs_id = 0
            var locs: List(LspLocation) = c.locations(r)
            var sb = StringBuilder()
            m.ref_lines = List(int)()
            m.ref_uris = List(str)()
            for l in locs
                sb.append(baseName(pathOfUri(l.uri)) + ":" + (l.line + 1).toString() + ":" + (l.col + 1).toString() + "\n")
                m.ref_lines.add(l.line)
                m.ref_uris.add(l.uri)
            m.refs!.setReadOnly(false)
            m.refs!.setText(sb.build())
            m.refs!.setReadOnly(true)
            m.status = locs.len.toString() + " reference(s)"
    if m.sym_id != 0
        if c.takeReply(m.sym_id) as r
            m.sym_id = 0
            m.sym_lines = List(int)()
            var outline_text: str = symbolLines(r, m.sym_lines)
            m.outline!.setReadOnly(false)
            m.outline!.setText(outline_text)
            m.outline!.setReadOnly(true)
            m.status = m.sym_lines.len.toString() + " symbol(s)"
    if m.rename_id != 0
        if c.takeReply(m.rename_id) as r
            m.rename_id = 0
            var res = r.at("result")
            if res.isNull() or res.at("changes").isNull()
                m.status = "rename: server returned no edits"
            else
                m.status = applyWorkspaceEdit(m, res.getObj("changes"))

def update(m: Model, msg: Msg): Model
    branch msg
        on Msg.tick
            tick(m)
            return m
        on Msg.open_file
            return m        # dialog result is delivered through Msg by view (button-gated there)
        on Msg.save_file
            if m.bufs.cur() as sb
                File.write(sb.path, m.editor!.getText())
                m.editor!.sci(SCI_SETSAVEPOINT, 0, 0)
                m.status = "saved " + baseName(sb.path)
            else
                m.status = "nothing to save"
            return m
        on Msg.select_tab as ti
            switchTo(m, ti)
            return m
        on Msg.close_tab
            closeCurrent(m)
            return m
        on Msg.goto_def
            if m.lsp as c
                if m.bufs.cur() as b
                    m.def_id = c.definition(b.uri, cursorLine(m.editor!), cursorCol(m.editor!))
            return m
        on Msg.find_refs
            if m.lsp as c
                if m.bufs.cur() as b
                    m.refs_id = c.references(b.uri, cursorLine(m.editor!), cursorCol(m.editor!))
            return m
        on Msg.symbols
            if m.lsp as c
                if m.bufs.cur() as b
                    m.sym_id = c.documentSymbol(b.uri)
            return m
        on Msg.rename
            if m.new_name == ""
                m.status = "rename: type the new name first"
                return m
            if m.lsp as c
                if m.bufs.cur() as b
                    m.rename_id = c.rename(b.uri, cursorLine(m.editor!), cursorCol(m.editor!), m.new_name)
            return m
        on Msg.jump_ref
            var i: int = cursorLine(m.refs!)
            if i < m.ref_lines.len
                if m.bufs.cur() as b
                    if m.ref_uris.at(i) != b.uri
                        openFile(m, pathOfUri(m.ref_uris.at(i)))
                gotoLineCol(m.editor!, m.ref_lines.at(i), 0)
            return m
        on Msg.jump_sym
            var i: int = cursorLine(m.outline!)
            if i < m.sym_lines.len
                gotoLineCol(m.editor!, m.sym_lines.at(i), 0)
            return m
        on Msg.next_bookmark
            var from: int = cursorLine(m.editor!) + 1
            var nxt: int = m.editor!.sci(SCI_MARKERNEXT, from, 8)
            if nxt < 0
                nxt = m.editor!.sci(SCI_MARKERNEXT, 0, 8)
            if nxt >= 0
                gotoLineCol(m.editor!, nxt, 0)
            return m

def view(g: Gui, m: Model)
    g.send(Msg.tick)
    using g.vbox("##root", true)
        using g.hbox("##toolbar", false)
            if g.button("Open…")
                var p = g.openFile()
                if p as path
                    openFile(m, path)
            if g.button("Save")
                g.send(Msg.save_file)
            if g.button("Definition")
                g.send(Msg.goto_def)
            if g.button("References")
                g.send(Msg.find_refs)
            if g.button("Symbols")
                g.send(Msg.symbols)
            m.new_name = g.input("new name", m.new_name)
            if g.button("Rename")
                g.send(Msg.rename)
            if g.button("Next bookmark")
                g.send(Msg.next_bookmark)
            if g.button("Close")
                g.send(Msg.close_tab)
        # fixed tab row: MAX_TABS buttons keyed by slot, relabelled as files open
        using g.hbox("##tabs", false)
            var dirty_now: bool = m.editor!.sci(SCI_GETMODIFY, 0, 0) != 0
            var t: int = 0
            while t < MAX_TABS
                var lbl: str = m.bufs.label(t, dirty_now and t == m.bufs.current)
                if lbl == ""
                    lbl = "·"
                if g.buttonId("##tab" + t.toString(), lbl)
                    g.send(Msg.select_tab(t))
                t = t + 1
        g.separator()
        using g.hbox("##body", true)
            m.editor!.render(g, "##code", 0, 0)
            using g.vbox("##side", false)
                g.text("References")
                m.refs!.render(g, "##refs", 0, 0)
                if g.button("Jump to reference")
                    g.send(Msg.jump_ref)
                g.text("Symbols")
                m.outline!.render(g, "##syms", 0, 0)
                if g.button("Jump to symbol")
                    g.send(Msg.jump_sym)
        g.separator()
        var dirty: str = ""
        if m.editor!.sci(SCI_GETMODIFY, 0, 0) != 0
            dirty = " *"
        var lsp_s: str = "no lsp"
        if m.lsp_ok
            lsp_s = "zebra lsp"
        var cur_path: str = ""
        if m.bufs.cur() as vb
            cur_path = vb.path
        g.text(cur_path + dirty + "   Ln " + (cursorLine(m.editor!) + 1).toString() + ", Col " + (cursorCol(m.editor!) + 1).toString()
               + "   " + m.editor!.getLanguage() + "   " + lsp_s + "   errors " + m.errors.toString() + "  warnings " + m.warnings.toString()
               + "   " + m.status)

def main()
    Gui.run("zebra-ide", 1200, 800, ideInit, update, view)
